// GroupBasket: family-pack group buying (DEC-030). Money is Decimal(14, 2), never Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  /// Delivery address and its map pin; baskets are found within 1 km of it
  address      String?
  city         String?
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now())
  /// Set when this login manages a company's dashboard (/company)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  sessions          Session[]
  tokenEntries      TokenEntry[]
  paymentAttempts   PaymentAttempt[]
  packMembers       PackMember[]
  startedPackGroups PackGroup[]         @relation("PackGroupStarter")
  contacts          UserContact[]
  resaleListings    ResaleListing[]
  reservations      ResaleReservation[]
}

model Session {
  /// SHA-256 of the cookie token
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Settings {
  id                 Int @id @default(1)
  paymentHoldMinutes Int @default(15)
}

model Company {
  id         String         @id @default(cuid())
  slug       String         @unique
  name       String
  /// Sample listing, not a real partnership
  demo       Boolean        @default(false)
  /// Logo and banner image paths: /logos/… or an uploaded /img/<id>
  logo       String?
  banner     String?
  active     Boolean        @default(true)
  sortOrder  Int            @default(0)
  packs      StandardPack[]
  deliveries PackDelivery[]
  managers   User[]
}

model StandardPack {
  id           String        @id @default(cuid())
  slug         String        @unique
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String
  durationDays Int
  /// Photo of all the items together: /img/<id>
  photo        String?
  active       Boolean       @default(true)
  versions     PackVersion[]
}

/// An image a company uploaded (banner, logo, pack photo), served by /img/<id>.
model Image {
  id        String   @id @default(cuid())
  companyId String
  type      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Fixed contents, price, size and commission; never edited once published.
model PackVersion {
  id             String       @id @default(cuid())
  packId         String
  pack           StandardPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  version        Int
  publishedAt    DateTime?
  /// Full price for one family; a basket of 5, 10 or 15 families takes that size's discount %
  pricePerFamily Decimal      @db.Decimal(14, 2)
  discount5      Decimal      @default(0) @db.Decimal(5, 2)
  discount10     Decimal      @default(0) @db.Decimal(5, 2)
  discount15     Decimal      @default(0) @db.Decimal(5, 2)
  householdSize  Int?
  commissionPct  Decimal      @default(0) @db.Decimal(5, 2)
  items          PackItem[]
  groups         PackGroup[]

  @@unique([packId, version])
}

model PackItem {
  id          String          @id @default(cuid())
  versionId   String
  version     PackVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name        String
  size        String
  qty         Int
  /// Shop price for one unit, shown next to the item
  retailPrice Decimal?        @db.Decimal(14, 2)
  /// Item photo: /img/<id>
  photo       String?
  /// Chilled or frozen goods can never be resold
  chilled     Boolean         @default(false)
  sortOrder   Int             @default(0)
  listings    ResaleListing[]
}

enum PackGroupStatus {
  /// Started; waiting for the owner's payment
  PENDING
  OPEN
  FULL
  CLOSED
}

/// A basket: one pack version, delivered to its owner (the first payer).
model PackGroup {
  id          String          @id @default(cuid())
  versionId   String
  version     PackVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User            @relation("PackGroupStarter", fields: [createdById], references: [id], onDelete: Restrict)
  /// The owner's address when the basket started
  lat         Float
  lng         Float
  address     String
  city        String?
  status      PackGroupStatus @default(PENDING)
  /// Families in this basket (5, 10 or 15), chosen by the owner; it never changes
  size        Int
  /// Price per family after the size's discount, fixed when the basket starts
  price       Decimal         @db.Decimal(14, 2)
  /// Held and paid spots
  joined      Int             @default(0)
  extensions  Int             @default(0)
  closesAt    DateTime
  createdAt   DateTime        @default(now())
  members     PackMember[]
  delivery    PackDelivery?

  @@index([versionId, status])
  @@index([status, closesAt])
  @@index([lat, lng])
}

enum PackMemberStatus {
  HELD
  PAID
}

model PackMember {
  id        String           @id @default(cuid())
  groupId   String
  group     PackGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    PackMemberStatus @default(HELD)
  heldUntil DateTime?
  paidAt    DateTime?
  joinedAt  DateTime         @default(now())
  attempts  PaymentAttempt[]
  listings  ResaleListing[]

  @@unique([groupId, userId])
  @@index([userId])
}

enum PackDeliveryStatus {
  ORDERED
  DISPATCHED
  RECEIVED
}

/// A full basket's one order to its company, delivered to the owner.
model PackDelivery {
  id         String             @id @default(cuid())
  groupId    String             @unique
  group      PackGroup          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  companyId  String
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  families   Int
  amountDue  Decimal            @db.Decimal(14, 2)
  status     PackDeliveryStatus @default(ORDERED)
  createdAt  DateTime           @default(now())
  receivedAt DateTime?
}

/// Phone numbers from a buyer's contacts (mobile app); their baskets are listed first.
model UserContact {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone  String

  @@id([userId, phone])
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  LATE_PAID
}

/// One payment for one basket spot.
model PaymentAttempt {
  id           String               @id @default(cuid())
  buyerId      String
  buyer        User                 @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  amount       Decimal              @db.Decimal(14, 2)
  currency     String               @default("LKR")
  status       PaymentAttemptStatus @default(PENDING)
  gatewayRef   String               @unique
  createdAt    DateTime             @default(now())
  expiresAt    DateTime
  packMemberId String?
  packMember   PackMember?          @relation(fields: [packMemberId], references: [id], onDelete: SetNull)
  events       PaymentEvent[]

  @@index([buyerId, createdAt])
  @@index([packMemberId])
  @@index([status, expiresAt])
}

/// Append-only record of verified gateway notices.
model PaymentEvent {
  id         String          @id @default(cuid())
  gateway    String
  eventId    String
  attemptId  String?
  attempt    PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  outcome    Json
  verifiedAt DateTime        @default(now())

  @@unique([gateway, eventId])
  @@index([attemptId])
}

enum TokenKind {
  /// A basket closed unfilled
  PACK_REFUND
  /// A payment that arrived after its spot was released, or for the wrong amount
  LATE_PAYMENT
}

/// Append-only (database trigger): entries are never updated or deleted.
model TokenEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount    Decimal   @db.Decimal(14, 2)
  kind      TokenKind
  eventKey  String    @unique
  note      String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum ResaleAudience {
  CONTACTS
  NEARBY
  BOTH
}

/// Unopened units from a buyer's paid spot in a full basket, offered at what the buyer paid
model ResaleListing {
  id           String              @id @default(cuid())
  sellerId     String
  seller       User                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  memberId     String
  member       PackMember          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  itemId       String
  item         PackItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// Units offered; cancelling keeps only the units already handed over
  qty          Int
  /// What the seller paid for one unit within the basket; never edited
  unitPrice    Decimal             @db.Decimal(14, 2)
  audience     ResaleAudience
  /// Public meeting place, shown only to the seller and buyers holding a reservation
  spot         String
  /// The basket's delivery point: only the area is shown, the point measures nearness
  city         String?
  lat          Float
  lng          Float
  cancelledAt  DateTime?
  createdAt    DateTime            @default(now())
  reservations ResaleReservation[]

  @@index([memberId, itemId])
  @@index([lat, lng])
  @@index([sellerId])
}

enum ResaleReservationStatus {
  RESERVED
  COMPLETED
  CANCELLED
  EXPIRED
}

model ResaleReservation {
  id          String                  @id @default(cuid())
  listingId   String
  listing     ResaleListing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId     String
  buyer       User                    @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  qty         Int
  status      ResaleReservationStatus @default(RESERVED)
  /// A reservation not completed by then no longer holds its units
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime                @default(now())

  @@index([listingId, status])
  @@index([buyerId])
  @@index([status, expiresAt])
}
