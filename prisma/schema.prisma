// GroupBasket data model. See CLAUDE.md "Business rules".
// Money is Decimal(14, 2), never Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

/// Every admin works in exactly one area (ADMIN-001/002); there is no unrestricted admin.
enum AdminArea {
  PREMIUM
  FACTORY
  /// Agents and orders (renamed from WAREHOUSE, area-agent model)
  AGENTS
  /// Settings and admin accounts only (product owner, 2026-11-03)
  CORE
}

/// A factory staff member's fixed job (product owner, 2026-11-04). Only owners see money.
enum FactoryRole {
  OWNER
  PACKING
  SALES
}

enum Role {
  /// A buyer: joins and fills carts
  CUSTOMER
  ADMIN
  /// A factory that supplies stock: lists products for an admin to review and publish
  SELLER
  /// An area agent who receives baskets from factories and hands parcels to buyers
  AGENT
}

model User {
  ownBaskets     Basket[]           @relation("BasketOwner")
  joinRequests   OwnJoinRequest[]
  holdMessages   FaultHoldMessage[]
  factoryFaults  FactoryFault[]
  faultHolds     FaultHold[]
  returnMessages ReturnMessage[]
  qualityNotices QualityNotice[]
  productRatings ProductRating[]
  id             String             @id @default(cuid())
  role           Role               @default(CUSTOMER)
  adminArea      AdminArea? // admins only
  name           String
  email          String             @unique
  phone          String?            @unique
  passwordHash   String
  /// Buyers: asked at sign-up; with the birth date it picks the shop's audience (2026-11-21)
  gender         Gender?
  birthDate      DateTime?          @db.Date
  /// Default drop-off for carts this user owns
  address        String?
  city           String?
  /// Exact map pin of the address (mandatory at sign-up)
  lat            Float?
  lng            Float?
  /// Sellers: the factory or company name
  company        String?
  /// Premium brand partner: offers gift products and fulfils paid basket gifts directly.
  /// `website` verifies retail references on the brand's own site.
  isBrand        Boolean            @default(false)
  website        String?
  locked         Boolean            @default(false)
  /// Factory staff: the factory account they work for, and their job. The factory account itself
  /// has neither and is always an owner.
  factoryId      String?
  factory        User?              @relation("FactoryStaff", fields: [factoryId], references: [id], onDelete: Cascade)
  factoryRole    FactoryRole?
  createdAt      DateTime           @default(now())

  staff                User[]                @relation("FactoryStaff")
  factoryProfile       FactoryProfile?
  factoryApplications  FactoryApplication[]  @relation("ApplicationFactory")
  reviewedApplications FactoryApplication[]  @relation("ApplicationReviewer")
  factoryActivations   FactoryActivation[]   @relation("ActivationOwner")
  createdActivations   FactoryActivation[]   @relation("ActivationCreator")
  factoryInvites       FactoryInvite[]
  factoryCategories    FactoryCategory[]     @relation("FactoryCategories")
  approvedCategories   FactoryCategory[]     @relation("FactoryCategoryApprover")
  factoryDocuments     FactoryDocument[]     @relation("FactoryDocuments")
  reviewedDocuments    FactoryDocument[]     @relation("DocumentReviewer")
  publishedAgreements  AgreementVersion[]
  factoryAcceptances   AgreementAcceptance[] @relation("AcceptanceFactory")
  acceptedAgreements   AgreementAcceptance[] @relation("AcceptancePerson")

  tokenEntries       TokenEntry[]
  sessions           Session[]
  notifications      Notification[]
  products           Product[]               @relation("SellerProducts")
  stockOffers        StockOffer[]            @relation("OfferSeller")
  stockReceived      StockOffer[]            @relation("StockReceivedBy")
  giftOrders         GiftOrder[]             @relation("GiftRecipient")
  brandSettlements   GiftSettlement[]
  brandConversations BrandConversation[]     @relation("ConversationBrand")
  brandMessages      BrandMessage[]
  brandReads         BrandConversationRead[]

  agent                Agent?
  bodyProfile          BodyProfile?
  bodyFitJobs          BodyFitJob[]
  deepFitJobs          DeepFitJob[]
  fitFeedback          FitFeedback[]
  cartItems            CartItem[]
  buyerOrders          Order[]           @relation("OrderBuyer")
  factoryOrders        Order[]           @relation("OrderFactory")
  buyerPaymentAttempts PaymentAttempt[]  @relation("AttemptBuyer")
  pickupCodes          PickupCode[]
  factoryBaskets       Basket[]          @relation("BasketFactory")
  factoryPayouts       FactoryPayout[]   @relation("PayoutFactory")
  paidPayouts          FactoryPayout[]   @relation("PayoutPaidBy")
  payoutDeductions     PayoutDeduction[] @relation("DeductionFactory")
  bookedCouriers       CourierBooking[]  @relation("CourierBookedBy")
  agentLossDecisions   AgentLoss[]       @relation("AgentLossDecider")
  /// Group deals this factory runs (DEAL-001)
  groupDeals           GroupDeal[]       @relation("FactoryDeals")

  @@index([factoryId])
}

model Session {
  /// SHA-256 of the cookie token
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Catalogue ─────────────────────────────────────────────────────────────

/// The category tree (DEC-029, CATG-001): Clothing > Men > Shirts. Fields left null or empty are
/// inherited from the parent (src/lib/categories.ts)
model Category {
  id            String               @id @default(cuid())
  parentId      String?
  parent        Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[]           @relation("CategoryTree")
  /// Segments from the root: "clothing/men/shirts"
  slug          String               @unique
  name          String
  /// Materialised ids from the root, "/<rootId>/<id>/", for subtree queries
  path          String
  sortOrder     Int                  @default(0)
  active        Boolean              @default(true)
  commissionPct Decimal?             @db.Decimal(5, 2)
  minCommission Decimal?             @db.Decimal(14, 2)
  /// Add-ons switched on for this subtree: "fit", "materials", "audience"
  features      String[]
  needsApproval Boolean              @default(false)
  /// Return and report reasons for this category on top of the general ones
  returnReasons String[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  attributes    CategoryAttribute[]
  products      Product[]
  factories     FactoryCategory[]
  applications  FactoryApplication[]

  @@index([parentId, sortOrder])
  @@index([path])
}

enum AttributeType {
  TEXT
  NUMBER
  ENUM
  BOOL
}

/// A property any product may have: "size", "colour", "pages", "volume_ml"
model AttributeDef {
  id         String              @id @default(cuid())
  key        String              @unique
  label      String
  type       AttributeType
  unit       String?
  options    AttributeOption[]
  categories CategoryAttribute[]
}

model AttributeOption {
  id        String       @id @default(cuid())
  defId     String
  def       AttributeDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  value     String
  label     String
  sortOrder Int          @default(0)

  @@unique([defId, value])
}

/// An attribute a category's products carry; inherited by every category below it
model CategoryAttribute {
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  defId         String
  def           AttributeDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  required      Boolean      @default(false)
  /// The buyer picks it (size, colour, pages, flavour)
  isVariantAxis Boolean      @default(false)
  /// Shown as a shop filter
  filterable    Boolean      @default(false)
  sortOrder     Int          @default(0)

  @@id([categoryId, defId])
  @@index([defId])
}

/// The state of what is sold (DEC-029)
enum Condition {
  NEW
  FACTORY_SURPLUS
  B_GRADE
  REFURBISHED
}

enum Gender {
  MALE
  FEMALE
}

enum ProductStatus {
  DRAFT
  /// A seller submitted it; an admin publishes it once the stock has arrived, or returns it
  IN_REVIEW
  LIVE
  ARCHIVED
}

model Product {
  ownBaskets     Basket[]
  productRatings ProductRating[]
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   String?
  hiddenByHoldId String?
  hiddenByHold   FaultHold?      @relation(fields: [hiddenByHoldId], references: [id], onDelete: Restrict)
  id             String          @id @default(cuid())
  title          String
  brand          String
  description    String          @default("")
  /// The category tree node (DEC-029); audience and clothing kind come from its slug
  categoryId     String
  categoryRef    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Product-level attribute values, checked against the category's attributes
  specs          Json            @default("{}")
  condition      Condition       @default(NEW)
  /// What one unit is: "piece", "pack", "box", "kg"
  sellUnit       String          @default("piece")
  /// Fewest units a buyer may order, and the step above it (a dozen pens: 12 and 12)
  minOrderQty    Int             @default(1)
  stepQty        Int             @default(1)
  shelfLifeDays  Int?
  hazmat         Boolean         @default(false)
  /// No longer used (defects removed by the product owner, 2026-10-17); kept so old notes aren't lost
  defectNotes    String?
  retailPrice    Decimal?        @db.Decimal(14, 2)
  price          Decimal         @db.Decimal(14, 2)
  factoryPrice   Decimal?        @db.Decimal(14, 2)
  commission     Decimal?        @db.Decimal(14, 2)
  status         ProductStatus   @default(DRAFT)
  photoKey       String?
  photoType      String?
  /// The factory that listed it; null for our own listings
  sellerId       String?
  seller         User?           @relation("SellerProducts", fields: [sellerId], references: [id])
  /// Why an admin returned it to the seller (shown to the seller)
  reviewNote     String?
  /// A luxury brand's product: the page on the brand's own website showing its actual price
  /// (`retailPrice`), linked from our product page (2026-10-24)
  brandUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  variants Variant[]
  /// Stock offers whose pieces went onto this product: a design test, then its bulk (2026-10-24)
  offers   StockOffer[]

  // ─── Fit data (DEC-020), entered by the factory ───
  /// Garment measurements in cm per size: { "M": { "chest": 108, "waist": 100 } }; keys are
  /// FitRegion names in lower camel case (src/lib/fit/regions.ts)
  sizeChart        Json?
  /// Most the fabric stretches, percent (0 = rigid)
  fabricStretchPct Int?
  gsm              Int?
  weave            String?
  thermalMinC      Int?
  thermalMaxC      Int?
  /// 1 (least) to 5 (most)
  breathability    Int?
  careNotes        String?
  /// An admin checked the fit data; the fit card ignores the size chart until then
  fitApprovedAt    DateTime?
  fitApprovedById  String?

  fitAssets      FitAsset[]
  regionTensions GarmentRegionTension[]
  fitFeedback    FitFeedback[]
  deepFitJobs    DeepFitJob[]
  clusterDrapes  ClusterDrape[]
  /// Fabric per role from the material library (DEC-022)
  materials      ProductMaterial[]
  /// Group deals with price tiers (DEAL-001)
  groupDeals     GroupDeal[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([specs(ops: JsonbPathOps)], type: Gin)
}

/// One option set of a product (DEC-029). available + reserved + sold is everything ever stocked.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The buyer's choices, e.g. {"size":"M","colour":"Navy"}; built by src/lib/variant-options.ts
  options   Json
  /// Normalised options: sorted lower-case "key=value" joined by "|"; "" when there are none
  optionKey String
  /// Shown on screens and tickets, e.g. "M / Navy"
  label     String
  sku       String?
  weightG   Int?
  lengthMm  Int?
  widthMm   Int?
  heightMm  Int?
  /// Free to add to a cart
  available Int     @default(0)
  /// Locked in carts that are not yet confirmed
  reserved  Int     @default(0)
  /// Turned into sales when a cart is confirmed
  sold      Int     @default(0)

  orderLines OrderLine[]
  cartItems  CartItem[]

  @@unique([productId, optionKey])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  dedupeKey String?   @unique

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Stock offers ──────────────────────────────────────────────────────────

/// A few pieces to test a design before the factory makes the bulk, or the bulk itself (2026-10-24)
enum OfferKind {
  TEST
  BULK
}

enum OfferStatus {
  IN_REVIEW
  ACCEPTED
  DECLINED
  CHANGES_REQUESTED
}

/// A factory seller's stock offer (product owner, 2026-10-19): a name, details about the stock and
/// the total price they want for all of it. An admin accepts or declines it (with an optional
/// note). It is not a shop product: if we take the stock, the admin lists it as a product.
model StockOffer {
  id               String               @id @default(cuid())
  sellerId         String
  seller           User                 @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  name             String
  description      String
  /// Factory lot total, or legacy brand capacity value (partner price × pieces); not a gift bill.
  amount           Decimal              @db.Decimal(14, 2)
  kind             OfferKind            @default(BULK)
  /// Brand retail reference, private charge per authorized gift, campaign capacity and source URL.
  actualPrice      Decimal?             @db.Decimal(14, 2)
  offerPrice       Decimal?             @db.Decimal(14, 2)
  pieces           Int?
  productUrl       String?
  photoKey         String?
  photoType        String?
  packDetails      String?
  packSize         String?
  dispatchDays     Int?
  hasExpiry        Boolean              @default(false)
  expiryDate       DateTime?            @db.Date
  minShelfLifeDays Int?
  paused           Boolean              @default(false)
  revision         Int                  @default(1)
  approvedRevision Int?
  revisions        BrandOfferRevision[]
  gifts            GiftOrder[]
  /// The shop product its pieces went onto; a tested design's bulk goes onto the same one
  productId        String?
  product          Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  status           OfferStatus          @default(IN_REVIEW)
  note             String?
  decidedAt        DateTime?
  /// Packing staff confirm an accepted offer's stock has reached our store (2026-10-20)
  receivedById     String?
  receivedBy       User?                @relation("StockReceivedBy", fields: [receivedById], references: [id])
  receivedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

enum GiftOrderStatus {
  RESERVED
  READY
  DISPATCHED
  DELIVERED
  ISSUE
  CANCELLED
}

model GiftOrder {
  id               String          @id @default(cuid())
  offerId          String
  offer            StockOffer      @relation(fields: [offerId], references: [id])
  recipientId      String
  recipient        User            @relation("GiftRecipient", fields: [recipientId], references: [id])
  status           GiftOrderStatus @default(RESERVED)
  retailValue      Decimal         @db.Decimal(14, 2)
  partnerPrice     Decimal         @db.Decimal(14, 2)
  recipientName    String
  phone            String
  address          String
  city             String
  authorizedById   String
  courier          String?
  tracking         String?
  issue            String?
  paidAt           DateTime?
  acknowledgedAt   DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  billApprovedAt   DateTime?
  billApprovedById String?
  settlementId     String?
  settlement       GiftSettlement? @relation(fields: [settlementId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([offerId, status])
  @@index([recipientId])
  @@index([settlementId])
}

model GiftSettlement {
  id          String      @id @default(cuid())
  brandId     String
  brand       User        @relation(fields: [brandId], references: [id])
  amount      Decimal     @db.Decimal(14, 2)
  reference   String
  settledById String
  paidAt      DateTime
  createdAt   DateTime    @default(now())
  receivedAt  DateTime?
  queryOpen   Boolean     @default(false)
  gifts       GiftOrder[]

  @@index([brandId, paidAt])
}

model BrandConversation {
  id            String                  @id @default(cuid())
  brandId       String
  brand         User                    @relation("ConversationBrand", fields: [brandId], references: [id])
  kind          String
  subjectId     String
  contextKey    String                  @unique
  title         String
  resolved      Boolean                 @default(false)
  lastHumanSide String?
  updatedAt     DateTime                @default(now())
  createdAt     DateTime                @default(now())
  messages      BrandMessage[]
  reads         BrandConversationRead[]

  @@index([brandId, updatedAt])
}

model BrandMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   BrandConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation(fields: [authorId], references: [id])
  body           String
  internal       Boolean           @default(false)
  system         Boolean           @default(false)
  requestKey     String?           @unique
  notifiedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([notifiedAt])
}

model BrandConversationRead {
  conversationId String
  conversation   BrandConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime

  @@id([conversationId, userId])
}

model BrandOfferRevision {
  id            String      @id @default(cuid())
  offerId       String
  offer         StockOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  status        OfferStatus @default(IN_REVIEW)
  submittedById String
  reviewedById  String?
  reviewedAt    DateTime?
  supersededAt  DateTime?
  createdAt     DateTime    @default(now())

  @@unique([offerId, version])
}

// ─── Settings ──────────────────────────────────────────────────────────────

/// One row (id = 1).
model Settings {
  commissionPerPiece Decimal @default(100) @db.Decimal(14, 2)
  id                 Int     @id @default(1)

  // Agent model
  /// Agent fee as a share of the item price (0.05 = 5%); the agent pays couriers from it
  agentFeeRate        Decimal   @default(0.05) @db.Decimal(6, 4)
  gatewayFeeRate      Decimal   @default(0.033) @db.Decimal(6, 4)
  basketLockAmount    Decimal   @default(50000) @db.Decimal(14, 2)
  maxWaitDays         Int       @default(60)
  paymentHoldMinutes  Int       @default(15)
  collectHours        Int       @default(48)
  returnHandoverDays  Int       @default(7)
  /// Days a buyer has to bring an accepted buyer-fault return to the agent
  buyerHandoverDays   Int       @default(2)
  agentRadiusM        Int       @default(1000)
  agentGapM           Int       @default(2000)
  agentDeposit        Decimal   @default(200000) @db.Decimal(14, 2)
  /// Own baskets (DEC-023): items the basket must hold before the owner can place the order
  ownMinItems         Int       @default(10)
  /// Own baskets (DEC-026): days from the first payment before the sweep places or refunds it
  ownMaxWaitDays      Int       @default(10)
  /// The last week end (Saturday 23:59:59.999 Asia/Colombo) whose payouts and agent fees were built
  payoutsBuiltThrough DateTime?
}

enum ApplicationStatus {
  WAITING
  APPROVED
  REJECTED
}

enum FactoryDocKind {
  BR_CERT
  NIC_PHOTO
  FACTORY_PHOTO
  /// Registration for a restricted category, for example food or cosmetics (DEC-029)
  PRODUCT_LICENCE
  /// Shows the factory is the maker or brand owner (DEC-029)
  TRADEMARK_PROOF
}

/// An admin review of a factory's category request or document (DEC-029)
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A category a factory may list in (CATG-003, DEC-029). Approval covers the whole subtree.
model FactoryCategory {
  id           String       @id @default(cuid())
  factoryId    String
  factory      User         @relation("FactoryCategories", fields: [factoryId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status       ReviewStatus @default(PENDING)
  approvedById String?
  approvedBy   User?        @relation("FactoryCategoryApprover", fields: [approvedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([factoryId, categoryId])
  @@index([status, createdAt])
}

enum FactoryStatus {
  ACTIVE
  REMOVED
}

model FactoryApplication {
  id            String            @id @default(cuid())
  businessName  String
  brNumber      String
  ownerName     String
  ownerNic      String
  phone         String
  email         String
  address       String
  city          String
  bankName      String
  bankBranch    String
  accountName   String
  accountNumber String
  status        ApplicationStatus @default(WAITING)
  reviewerId    String?
  reviewer      User?             @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  visitDate     DateTime?
  visitNotes    String?
  inviteId      String?           @unique
  invite        FactoryInvite?    @relation(fields: [inviteId], references: [id])
  factoryUserId String?
  factory       User?             @relation("ApplicationFactory", fields: [factoryUserId], references: [id])
  /// The main root category the factory makes (DEC-029); optional
  industryId    String?
  industry      Category?         @relation(fields: [industryId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  documents     FactoryDocument[]

  @@index([brNumber])
  @@index([ownerNic])
  @@index([status, createdAt])
  @@index([factoryUserId])
}

/// Sent with an application, or later from the factory workspace (`factoryId`, DEC-029)
model FactoryDocument {
  id            String              @id @default(cuid())
  applicationId String?
  application   FactoryApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  factoryId     String?
  factory       User?               @relation("FactoryDocuments", fields: [factoryId], references: [id], onDelete: Cascade)
  kind          FactoryDocKind
  storageKey    String
  contentType   String
  status        ReviewStatus        @default(PENDING)
  reviewedById  String?
  reviewedBy    User?               @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())

  @@index([applicationId])
  @@index([factoryId, kind, status])
  @@index([status, createdAt])
}

model FactoryInvite {
  id          String              @id @default(cuid())
  token       String              @unique
  phone       String?
  email       String?
  invitedBy   String
  inviter     User                @relation(fields: [invitedBy], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  application FactoryApplication?
}

model AgreementVersion {
  id          String                @id @default(cuid())
  version     Int                   @unique
  text        String
  publishedAt DateTime              @default(now())
  publishedBy String
  publisher   User                  @relation(fields: [publishedBy], references: [id])
  acceptances AgreementAcceptance[]
}

model AgreementAcceptance {
  id            String           @id @default(cuid())
  factoryUserId String
  factory       User             @relation("AcceptanceFactory", fields: [factoryUserId], references: [id], onDelete: Cascade)
  acceptedById  String
  acceptedBy    User             @relation("AcceptancePerson", fields: [acceptedById], references: [id])
  versionId     String
  version       AgreementVersion @relation(fields: [versionId], references: [id])
  acceptedAt    DateTime         @default(now())
  endsAt        DateTime
  remindedAt    DateTime?

  @@index([factoryUserId, acceptedAt])
  @@index([remindedAt, endsAt])
}

model FactoryProfile {
  factoryUserId    String        @id
  factory          User          @relation(fields: [factoryUserId], references: [id], onDelete: Cascade)
  status           FactoryStatus @default(ACTIVE)
  complianceDueAt  DateTime?
  removedAt        DateTime?
  removedById      String?
  removalReason    String?
  earningsHeld     Boolean       @default(false)
  earningsHeldNote String?
}

model LoginAttempt {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model FactoryActivation {
  /// SHA-256 of the raw activation token; never a session credential.
  id          String    @id
  userId      String
  user        User      @relation("ActivationOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ActivationCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

enum TokenKind {
  RETURN
  HOLD
  RELEASE
  SPEND
  LATE_PAYMENT
  ORDER_CANCEL
  AGENT_FEE
  COURIER_REPAY
  FEE_CLAWBACK
  MISSING_ITEM
  DEPOSIT_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  /// A group deal settled below the price paid (DEAL-002)
  DEAL_REBATE
}

model TokenEntry {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount         Decimal   @db.Decimal(14, 2)
  kind           TokenKind
  /// Audit references without foreign keys
  returnId       String?
  orderId        String?
  orderLineId    String?
  counterpartyId String?
  eventKey       String    @unique
  note           String
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([orderLineId])
}

enum LineStatus {
  ACTIVE
  CANCELLED
  RETURNED
}

enum ReportReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  MISSING_PARTS
  EXPIRED
  STITCHING
  SIZE
  OTHER
}

model ProductRating {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  stars     Int
  createdAt DateTime       @default(now())
  report    QualityReport?

  @@unique([orderId, userId, productId])
  @@index([productId, createdAt])
}

model QualityReport {
  id        String        @id @default(cuid())
  ratingId  String        @unique
  rating    ProductRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  reason    ReportReason
  note      String
  createdAt DateTime      @default(now())
  photos    ReportPhoto[]

  @@index([createdAt])
}

model ReportPhoto {
  id          String        @id @default(cuid())
  reportId    String
  report      QualityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String

  @@index([reportId])
}

model QualityNotice {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  title       String
  body        String
  href        String
  deliveredAt DateTime?

  @@index([deliveredAt])
}

enum ReturnStatus {
  WAITING_FACTORY
  WITH_ADMIN
  ACCEPTED
  REJECTED
  PICKED_UP
  RECEIVED
  COMPLETED
  AWAITING_HANDOVER
  HANDED_OVER
  LAPSED
  BUYER_REQUESTED
  WITH_AGENT
  SOLD
  TAKEN_BACK
}

enum BuyerFaultReason {
  MATERIAL
  SIZE
  COLOUR
  QUALITY_FEEL
  CHANGED_MIND
  OTHER
}

enum ReturnFault {
  FACTORY
  BUYER
}

model ReturnRequest {
  factoryFault       FactoryFault?
  factoryNote        String?
  messages           ReturnMessage[]
  id                 String            @id @default(cuid())
  orderLineId        String
  orderLine          OrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  handoverAgentId    String?
  handoverAgent      Agent?            @relation("ReturnHandoverAgent", fields: [handoverAgentId], references: [id], onDelete: Restrict)
  handoverDueAt      DateTime?
  handedOverAt       DateTime?
  sentBackBasketId   String?
  sentBackBasket     Basket?           @relation("ReturnSentBack", fields: [sentBackBasketId], references: [id], onDelete: Restrict)
  buyerId            String
  factoryId          String
  qty                Int
  reason             ReportReason?
  buyerReason        BuyerFaultReason?
  changedToBuyerAt   DateTime?
  buyerDecidedById   String?
  resoldAt           DateTime?
  takenBackAt        DateTime?
  fault              ReturnFault
  note               String
  status             ReturnStatus      @default(WAITING_FACTORY)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  factoryDueAt       DateTime
  factoryDecidedAt   DateTime?
  factoryDecidedById String?
  escalatedAt        DateTime?
  adminDecision      Boolean?
  adminId            String?
  adminNote          String?
  receivedAt         DateTime?
  receivedById       String?
  /// Received unused, tags on or seal unbroken
  unusedSealed       Boolean?
  receivedCondition  String?
  paidBy             ReturnFault?
  photos             ReturnPhoto[]
  notices            ReturnNotice[]

  @@index([factoryId, status])
  @@index([buyerId, createdAt])
  @@index([status, factoryDueAt])
  @@index([orderLineId])
  @@index([handoverAgentId, status])
  @@index([fault, status, createdAt])
}

/// A factory-fault return takes the agent fee back; `left` is what the agent still owes.
model AgentFeeClawback {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  returnId  String   @unique
  amount    Decimal  @db.Decimal(14, 2)
  left      Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@index([agentId, left])
}

model ReturnPhoto {
  id          String        @id @default(cuid())
  returnId    String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String

  @@index([returnId])
}

model ReturnNotice {
  id          String        @id
  returnId    String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  href        String
  deliveredAt DateTime?

  @@index([deliveredAt])
}

model ReturnMessage {
  id        String        @id @default(cuid())
  returnId  String
  request   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String        @db.VarChar(1000)
  createdAt DateTime      @default(now())

  @@index([returnId, createdAt])
  @@index([authorId, createdAt])
}

enum FaultConfirmedBy {
  FACTORY
  ADMIN
}

enum HoldDecision {
  CONTINUE
  REMOVE
}

model FactoryFault {
  id            String           @id @default(cuid())
  factoryId     String
  factory       User             @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  returnId      String           @unique
  request       ReturnRequest    @relation(fields: [returnId], references: [id], onDelete: Restrict)
  units         Int
  recordedAt    DateTime         @default(now())
  confirmedBy   FaultConfirmedBy
  confirmedById String
  cancelledAt   DateTime?
  cancelledById String?
  cancelNote    String?          @db.VarChar(2000)

  @@index([factoryId, recordedAt])
}

model FaultHold {
  id           String             @id @default(cuid())
  factoryId    String
  factory      User               @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  openedAt     DateTime           @default(now())
  cleanedAt    DateTime?
  decision     HoldDecision?
  decisionNote String?            @db.VarChar(2000)
  decidedAt    DateTime?
  decidedById  String?
  products     Product[]
  messages     FaultHoldMessage[]

  @@index([factoryId, openedAt])
}

model FaultHoldMessage {
  id        String    @id @default(cuid())
  holdId    String
  hold      FaultHold @relation(fields: [holdId], references: [id], onDelete: Restrict)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String    @db.VarChar(1000)
  createdAt DateTime  @default(now())

  @@index([holdId, createdAt])
  @@index([authorId, createdAt])
}

// ─── Area agent model ──────────────────────────────────────────────────────

enum AgentStatus {
  APPLIED
  APPROVED
  LIVE
  SUSPENDED
  LEAVING
  LEFT
  REJECTED
}

model Agent {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           AgentStatus @default(APPLIED)
  lat              Float
  lng              Float
  address          String
  city             String?
  /// Private storage keys; never public.
  nicKey           String?
  photoKey         String?
  storagePhotoKeys String[]
  depositPaidAt    DateTime?
  depositAmount    Decimal     @default(0) @db.Decimal(14, 2)
  leftAt           DateTime?
  lossAmount       Decimal     @default(0) @db.Decimal(14, 2)
  lossNote         String?
  suspendedAt      DateTime?
  /// Admin's note on the latest decision: rejection or suspension reason
  statusNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  hours           AgentHours[]
  baskets         Basket[]
  orders          Order[]
  pickupCodes     PickupCode[]
  pickupAttempts  PickupAttempt[]
  losses          AgentLoss[]
  paymentAttempts PaymentAttempt[]
  handoverReturns ReturnRequest[]    @relation("ReturnHandoverAgent")
  feeClawbacks    AgentFeeClawback[]

  @@index([status])
}

model AgentHours {
  id       String @id @default(cuid())
  agentId  String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// 0 = Sunday .. 6 = Saturday
  weekday  Int
  /// Minutes after midnight, Asia/Colombo
  opensAt  Int
  closesAt Int

  @@unique([agentId, weekday])
}

model AgentLoss {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(14, 2)
  reason      String
  photoKeys   String[]
  decidedById String
  decidedBy   User     @relation("AgentLossDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([agentId])
}

/// Code entries at an agent's box, so repeated wrong codes can block it.
model PickupAttempt {
  id      String   @id @default(cuid())
  agentId String
  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  at      DateTime @default(now())
  ok      Boolean

  @@index([agentId, at])
}

/// A buyer's saved wish. Holds no stock.
model CartItem {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  createdAt DateTime @default(now())

  @@unique([buyerId, variantId])
  @@index([variantId])
}

enum BasketStatus {
  OPEN
  LOCKED
  PACKED
  WITH_COURIER
  AT_AGENT
  /// Own baskets: closed by the owner (or max wait), waiting for the delivery fee
  AWAITING_FEE
  /// Own baskets: delivered to the owner's address
  DELIVERED
  /// Own baskets: the owner never paid; every paid order was refunded in tokens
  CANCELLED
}

enum BasketLockReason {
  AMOUNT
  MAX_WAIT
  SUSPENDED
  /// Own baskets: the owner closed it and paid the delivery fee
  OWNER
}

enum BasketKind {
  AGENT
  OWN
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A buyer asks to join someone's own basket; the owner accepts or declines (DEC-028). One per
/// buyer and basket. `lines` are the items wanted when asking ([{ variantId, qty }]), shown to
/// the owner; payment comes after acceptance, from the cart.
model OwnJoinRequest {
  id        String            @id @default(cuid())
  basketId  String
  basket    Basket            @relation(fields: [basketId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  lines     Json
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  @@unique([basketId, buyerId])
  @@index([buyerId])
}

enum BasketVisibility {
  LINK
  PUBLIC
}

/// The partial unique index "Basket_one_open" (one OPEN per agent and factory) is added by hand
/// in the migration SQL; Prisma cannot express it.
model Basket {
  id           String            @id @default(cuid())
  kind         BasketKind        @default(AGENT)
  /// Agent baskets only
  agentId      String?
  agent        Agent?            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  factoryId    String
  factory      User              @relation("BasketFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  status       BasketStatus      @default(OPEN)
  /// Goods value only (items total)
  total        Decimal           @default(0) @db.Decimal(14, 2)
  firstOrderAt DateTime?
  lockedAt     DateTime?
  lockReason   BasketLockReason?
  createdAt    DateTime          @default(now())

  // Own baskets (DEC-023, DEC-027): one factory, delivered to the owner, no agent, no returns.
  // productId is set only on older baskets that were started for one product.
  ownerId         String?
  owner           User?             @relation("BasketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  productId       String?
  product         Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Older baskets only: joining is by request now (DEC-028)
  visibility      BasketVisibility?
  shareCode       String?           @unique
  deliveryAddress String?
  deliveryArea    String?
  deliveryPhone   String?
  deliveryFee     Decimal?          @db.Decimal(14, 2)
  closedAt        DateTime?
  feeDueAt        DateTime?
  feePaidAt       DateTime?
  deliveredAt     DateTime?

  orders          Order[]
  targetOrders    Order[]          @relation("OrderTargetBasket")
  feeAttempts     PaymentAttempt[] @relation("AttemptBasket")
  courier         CourierBooking?
  sentBackReturns ReturnRequest[]  @relation("ReturnSentBack")
  joinRequests    OwnJoinRequest[]

  @@index([status])
  @@index([agentId, status])
  @@index([factoryId, status])
  @@index([kind, status, productId])
  @@index([ownerId])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  RECEIVED
}

model Order {
  id               String          @id @default(cuid())
  buyerId          String
  buyer            User            @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// Null for own-basket orders (DEC-023)
  agentId          String?
  agent            Agent?          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  /// Own-basket orders: the basket the order joins when paid
  targetBasketId   String?
  targetBasket     Basket?         @relation("OrderTargetBasket", fields: [targetBasketId], references: [id], onDelete: Restrict)
  factoryId        String
  factory          User            @relation("OrderFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  /// Set when paid
  basketId         String?
  basket           Basket?         @relation(fields: [basketId], references: [id], onDelete: Restrict)
  paymentAttemptId String?
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  status           OrderStatus     @default(PENDING)
  itemsTotal       Decimal         @db.Decimal(14, 2)
  courierTotal     Decimal         @db.Decimal(14, 2)
  agentFeeTotal    Decimal         @db.Decimal(14, 2)
  tokensApplied    Decimal         @default(0) @db.Decimal(14, 2)
  gatewayFee       Decimal         @default(0) @db.Decimal(14, 2)
  amountDue        Decimal         @db.Decimal(14, 2)
  holdUntil        DateTime
  paidAt           DateTime?
  receivedAt       DateTime?
  /// The buyer's checkout request key; repeats return the first result
  checkoutKey      String?
  createdAt        DateTime        @default(now())

  lines          OrderLine[]
  productRatings ProductRating[]

  @@index([buyerId, createdAt])
  @@index([buyerId, checkoutKey])
  @@index([basketId])
  @@index([paymentAttemptId])
  @@index([agentId, status])
  @@index([factoryId, status])
  @@index([status, holdUntil])
  @@index([targetBasketId, status])
}

model OrderLine {
  id                  String     @id @default(cuid())
  orderId             String
  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String
  variant             Variant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  /// Snapshot of Variant.label at checkout or own-basket payment
  variantLabel        String     @default("")
  qty                 Int
  /// Snapshot: factory price + commission
  unitPrice           Decimal    @db.Decimal(14, 2)
  /// Snapshot
  factoryPrice        Decimal    @db.Decimal(14, 2)
  /// Snapshot of the courier charge per piece
  courierEach         Decimal    @db.Decimal(14, 2)
  /// Snapshot of the agent fee per piece paid online; 0 since the fee is paid at pickup (DEC-019)
  agentFeeEach        Decimal    @db.Decimal(14, 2)
  /// Snapshot of the agent fee per piece the buyer pays the agent in cash at pickup
  cashFeeEach         Decimal    @default(0) @db.Decimal(14, 2)
  /// The cash fee the agent confirmed at handover
  cashFeePaid         Decimal?   @db.Decimal(14, 2)
  status              LineStatus @default(ACTIVE)
  returnedQty         Int        @default(0)
  missingQty          Int        @default(0)
  /// Pending factory report of units it cannot supply; an admin removes them
  missingReportedQty  Int        @default(0)
  missingNote         String?
  missingReportedAt   DateTime?
  missingReportedById String?
  collectedAt         DateTime?
  /// Group deal lines (DEAL-002): the deal, tier 1's buyer price paid, and the final tier's buyer
  /// and factory prices once the deal settles
  dealId              String?
  deal                GroupDeal? @relation(fields: [dealId], references: [id], onDelete: Restrict)
  paidUnitPrice       Decimal?   @db.Decimal(14, 2)
  finalUnitPrice      Decimal?   @db.Decimal(14, 2)
  finalFactoryPrice   Decimal?   @db.Decimal(14, 2)

  returns     ReturnRequest[]
  payoutItems PayoutItem[]
  fitFeedback FitFeedback?

  @@index([orderId])
  @@index([variantId])
  @@index([dealId])
}

enum DealStatus {
  DRAFT
  LIVE
  /// Ended; waits for unpaid orders to pay or expire, then settles
  CLOSED
  SETTLED
  CANCELLED
}

/// A factory's group deal on one product (DEAL-001, DEC-029). At most one LIVE deal per product
/// (partial unique index in SQL). unitsHeld counts units in orders waiting for payment; they move
/// to unitsSold when the payment is verified, so tiers count paid units only.
model GroupDeal {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  factoryId   String
  factory     User       @relation("FactoryDeals", fields: [factoryId], references: [id], onDelete: Restrict)
  startsAt    DateTime   @default(now())
  endsAt      DateTime
  /// The factory's capacity; no new orders beyond it
  maxQty      Int?
  status      DealStatus @default(DRAFT)
  unitsSold   Int        @default(0)
  unitsHeld   Int        @default(0)
  finalTierId String?    @unique
  finalTier   PriceTier? @relation("DealFinalTier", fields: [finalTierId], references: [id], onDelete: Restrict)
  settledAt   DateTime?
  createdAt   DateTime   @default(now())

  tiers PriceTier[] @relation("DealTiers")
  lines OrderLine[]

  @@index([status, endsAt])
  @@index([productId, status])
  @@index([factoryId])
}

model PriceTier {
  id           String     @id @default(cuid())
  dealId       String
  deal         GroupDeal  @relation("DealTiers", fields: [dealId], references: [id], onDelete: Cascade)
  /// Tier 1 has minQty 1
  minQty       Int
  factoryPrice Decimal    @db.Decimal(14, 2)
  /// factoryPrice + commission, copied when the deal goes live (src/lib/price-rules.ts)
  buyerPrice   Decimal    @db.Decimal(14, 2)
  finalOf      GroupDeal? @relation("DealFinalTier")

  @@unique([dealId, minQty])
}

enum PaymentPurpose {
  ORDERS
  DEPOSIT
  /// An own basket's delivery fee, paid by the owner at close
  DELIVERY_FEE
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  LATE_PAID
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  purpose          PaymentPurpose
  buyerId          String?
  buyer            User?                @relation("AttemptBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// Deposits only
  agentId          String?
  agent            Agent?               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  amount           Decimal              @db.Decimal(14, 2)
  /// Deposits only: the deposit charged, without the gateway fee; returned on leaving
  depositPrincipal Decimal?             @db.Decimal(14, 2)
  /// Delivery fees only
  basketId         String?
  basket           Basket?              @relation("AttemptBasket", fields: [basketId], references: [id], onDelete: Restrict)
  currency         String               @default("LKR")
  status           PaymentAttemptStatus @default(PENDING)
  gatewayRef       String               @unique
  createdAt        DateTime             @default(now())
  expiresAt        DateTime

  orders Order[]
  events PaymentEvent[]

  @@index([buyerId, createdAt])
  @@index([agentId])
  @@index([status, expiresAt])
}

/// Append-only record of verified gateway notices.
model PaymentEvent {
  id         String          @id @default(cuid())
  gateway    String
  eventId    String
  attemptId  String?
  attempt    PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  outcome    Json
  verifiedAt DateTime        @default(now())

  @@unique([gateway, eventId])
  @@index([attemptId])
}

model PickupCode {
  id      String @id @default(cuid())
  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Six digits, unique among the agent's codes
  code    String

  @@unique([buyerId, agentId])
  @@unique([agentId, code])
}

model CourierBooking {
  id              String    @id @default(cuid())
  basketId        String    @unique
  basket          Basket    @relation(fields: [basketId], references: [id], onDelete: Restrict)
  fee             Decimal   @db.Decimal(14, 2)
  driverName      String
  driverPhone     String
  vehicleNo       String
  bookedById      String
  bookedBy        User      @relation("CourierBookedBy", fields: [bookedById], references: [id], onDelete: Restrict)
  givenToDriverAt DateTime?
  receivedAt      DateTime?
  failedAt        DateTime?
  createdAt       DateTime  @default(now())
}

model FactoryPayout {
  id         String    @id @default(cuid())
  factoryId  String
  factory    User      @relation("PayoutFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  /// Saturday 23:59:59 Asia/Colombo
  weekEnding DateTime
  gross      Decimal   @db.Decimal(14, 2)
  deductions Decimal   @default(0) @db.Decimal(14, 2)
  net        Decimal   @db.Decimal(14, 2)
  bankRef    String?
  paidAt     DateTime?
  paidById   String?
  paidBy     User?     @relation("PayoutPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())

  items         PayoutItem[]
  deductionRows PayoutDeduction[]

  @@unique([factoryId, weekEnding])
  @@index([paidAt])
}

model PayoutItem {
  id          String        @id @default(cuid())
  payoutId    String
  payout      FactoryPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(14, 2)

  @@unique([orderLineId])
  @@index([payoutId])
}

enum DeductionKind {
  RETURN_COURIER
  MISSING_ITEM
  /// The buyer's cash agent fee refunded on a factory-fault return (DEC-019)
  AGENT_FEE
}

model PayoutDeduction {
  id        String         @id @default(cuid())
  factoryId String
  factory   User           @relation("DeductionFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  /// Null while the deduction waits for the next payout
  payoutId  String?
  payout    FactoryPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  kind      DeductionKind
  amount    Decimal        @db.Decimal(14, 2)
  ref       String
  createdAt DateTime       @default(now())

  @@unique([kind, ref])
  @@index([factoryId, payoutId])
}

// ─── Personalized fit (DEC-020) ─────────────────────────────────────────────

enum FitRegion {
  CHEST
  WAIST
  HIP
  UPPER_ARM
  THIGH
  SHOULDER
  TORSO
}

enum MotionClip {
  WALK
  RUN
  REACH
  SIT
}

enum FitFeedbackVerdict {
  TOO_TIGHT
  GOOD
  TOO_LOOSE
}

/// A body shape the offline simulation ran on
model BodyArchetype {
  id        String   @id @default(cuid())
  name      String   @unique
  /// "MEN" or "WOMEN"
  gender    String
  /// Body measurements in cm, keyed like the size chart
  params    Json
  /// This shape as an Anny body file with a skeleton (public); null until it is generated
  bodyUrl   String?
  createdAt DateTime @default(now())

  profiles BodyProfile[]
  assets   FitAsset[]
  tensions GarmentRegionTension[]
  drapes   ClusterDrape[]
}

/// A buyer's measurements, worked out on their phone. Photos are never uploaded.
model BodyProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm     Float
  /// { "chest": { "value": 96, "low": 92, "high": 100, "source": "photo" | "typed" } }
  measurements Json
  /// "MEN" or "WOMEN", optional
  gender       String?
  ageBand      String?
  archetypeId  String?
  archetype    BodyArchetype?   @relation(fields: [archetypeId], references: [id], onDelete: SetNull)
  /// Photo checks, model used, typed corrections against the photo estimate
  captureMeta  Json?
  consentAt    DateTime
  /// The buyer's own 3D body (DEC-021): null until the phone sends outlines
  bodyStatus   BodyModelStatus?
  /// Private storage key of the fitted body glb, served only to its owner
  bodyFileKey  String?
  /// Fit result: Anny parameters, quality and measurements from the fitted body
  bodyFit      Json?
  bodyFitAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

enum BodyModelStatus {
  BUILDING
  CHECK
  CONFIRMED
  FAILED
}

enum BodyFitJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// One body build (DEC-021). `input` holds the phone's outlines and joints, never photos; it is
/// cleared when the buyer confirms the body and swept after 7 days.
model BodyFitJob {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    BodyFitJobStatus @default(QUEUED)
  input     Json?
  attempts  Int              @default(0)
  error     String?
  startedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// A Deep Fit Test (DEC-021): one garment cloth-simulated on the buyer's own confirmed body by the
/// sim worker. Valid only while the body (bodyFitAt) and the product's fit data (fitDataHash) match.
model DeepFitJob {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  status      BodyFitJobStatus @default(QUEUED)
  attempts    Int              @default(0)
  error       String?
  /// The body the test ran on (BodyProfile.bodyFitAt when requested)
  bodyFitAt   DateTime
  /// SHA-256 of the product's size chart and fabric fields when requested
  fitDataHash String
  /// Per size: tension per area and the private garment file's storage key
  result      Json?
  startedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// One garment size cloth-simulated on a standard shape's body (DEC-021): a skinned glb on the CDN,
/// valid only for the fit data it was simulated from
model ClusterDrape {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  archetypeId String
  archetype   BodyArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  size        String
  garmentUrl  String
  /// fitDataHash (src/server/deep-fit-jobs.ts) of the product when simulated
  fitDataHash String
  createdAt   DateTime      @default(now())

  @@unique([productId, archetypeId, size])
}

/// Simulated garment on one archetype in one motion: an animated glTF on the CDN
model FitAsset {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  archetypeId String
  archetype   BodyArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  motion      MotionClip
  gltfUrl     String
  createdAt   DateTime      @default(now())

  @@unique([productId, archetypeId, motion])
}

/// Simulated tension of one garment size on one archetype, per body area (0 slack to 1 tight)
model GarmentRegionTension {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  archetypeId String
  archetype   BodyArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  size        String
  region      FitRegion
  baseTension Float
  note        String        @default("")

  @@unique([productId, archetypeId, size, region])
  @@index([productId, archetypeId])
}

/// "How did it fit?" after collection; calibrates the fit constants
model FitFeedback {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLineId   String             @unique
  orderLine     OrderLine          @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  purchasedSize String
  verdict       FitFeedbackVerdict
  /// { "chest": "TOO_TIGHT" } per area, optional
  regionNotes   Json?
  /// The size recommended and the tensions shown when the buyer looked, if they had a profile
  recommended   String?
  createdAt     DateTime           @default(now())

  @@index([productId])
}

// ─── Material library (DEC-022) ─────────────────────────────────────────────
// Every buyer-facing value traces to a Measurement, an Evidence row (claim + Source) or a
// versioned MethodologyRule; anything else is null and shown as "Not yet measured".
// CHECK constraints and the MethodologyRule append-only trigger live in the migration.

enum FiberFamily {
  NATURAL_PLANT
  NATURAL_ANIMAL
  REGENERATED_CELLULOSIC
  SYNTHETIC
}

enum ConstructionCategory {
  WEFT_KNIT
  WARP_KNIT
  WOVEN
  OTHER
}

enum StretchType {
  NONE
  MECHANICAL
  TWO_WAY
  FOUR_WAY
}

enum MaterialStatus {
  DRAFT
  PUBLISHED
}

/// A = test standard or peer-reviewed; B = university, government, institute, association;
/// C = trade guide or blog (only when no A/B source exists; flagged for upgrade)
enum SourceTier {
  A
  B
  C
}

enum EvidenceSubject {
  FIBER
  YARN_PROCESS
  FIBER_STANDARD
  CONSTRUCTION
  FINISH
  MATERIAL
  LAB
}

enum TestStandard {
  KES_FB2_BENDING
  KES_FB4_SURFACE
  KES_FB3_COMPRESSION
  AATCC_TM202
  AATCC_TM218
  ASTM_D1388
  FAST2
  ISO_3801
  EN_12127
  ASTM_D3776
  ISO_9237
  ASTM_D737
  ISO_11092
  AATCC_TM195
  AATCC_TM199
  ISO_20932_1
  ASTM_D2594
  ASTM_D3107
  ISO_5077
  AATCC_TM135
  ISO_12945_2
  ISO_12947_2
  BS_5058
  AATCC_TM128
  AATCC_EP5_PANEL
}

enum MeasureDirection {
  WARP
  WEFT
  WALE
  COURSE
  AVG
}

enum MaterialRole {
  SHELL
  LINING
  TRIM
  RIB_COLLAR
}

enum VerificationLevel {
  LIBRARY_ESTIMATE
  FACTORY_DECLARED
  LAB_MEASURED
}

enum FeelAxisKey {
  SOFT_FIRM
  LIGHT_SUBSTANTIAL
  SMOOTH_TEXTURED
  BREATHABLE_INSULATING
}

enum AxisBasis {
  MEASURED
  /// A point from a factory-declared figure (e.g. gsm), not a lab test
  DECLARED
  ESTIMATED
  NOT_AVAILABLE
}

model Fiber {
  id                String      @id @default(cuid())
  code              String      @unique
  name              String
  family            FiberFamily
  speciesOrPolymer  String?
  /// Numbers need an Evidence row with the same attribute name, or stay null
  stapleLengthMmMin Float?
  stapleLengthMmMax Float?
  moistureRegainPct Float?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  materials MaterialFiber[]
}

model YarnProcess {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  materials   Material[]
}

model FiberStandard {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  certifyingBody String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fibers         MaterialFiber[]
}

model Construction {
  id                   String               @id @default(cuid())
  code                 String               @unique
  name                 String
  category             ConstructionCategory
  structureDescription String?
  typicalGsmMin        Int?
  typicalGsmMax        Int?
  typicalEndUses       String[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  materials            Material[]
}

model Finish {
  id                String     @id @default(cuid())
  code              String     @unique
  name              String
  effectDescription String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  materials         Material[]
}

/// A library fabric. Factories pick one per product; buyers see it only once PUBLISHED.
model Material {
  id              String         @id @default(cuid())
  code            String         @unique
  displayName     String
  constructionId  String
  construction    Construction   @relation(fields: [constructionId], references: [id])
  yarnProcessId   String?
  yarnProcess     YarnProcess?   @relation(fields: [yarnProcessId], references: [id])
  finishId        String
  finish          Finish         @relation(fields: [finishId], references: [id])
  defaultGsmMin   Int?
  defaultGsmMax   Int?
  stretchType     StretchType?
  /// Editorial buyer copy ("a soft everyday T-shirt"), reviewed against the evidence
  feelsLikeAnchor String?
  endUses         String[]
  status          MaterialStatus @default(DRAFT)
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fibers       MaterialFiber[]
  products     ProductMaterial[]
  swatches     CalibrationSwatch[]
  measurements Measurement[]

  @@index([status])
}

/// Percentages of one material sum to 100 (checked by the service and the loader)
model MaterialFiber {
  id              String         @id @default(cuid())
  materialId      String
  material        Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fiberId         String
  fiber           Fiber          @relation(fields: [fiberId], references: [id])
  fiberStandardId String?
  fiberStandard   FiberStandard? @relation(fields: [fiberStandardId], references: [id])
  percentage      Int

  @@unique([materialId, fiberId, fiberStandardId])
}

model Source {
  id            String     @id @default(cuid())
  /// Stable reference used by seed files, e.g. "S12"
  code          String     @unique
  title         String
  publisher     String
  url           String
  publishedYear Int?
  accessedOn    DateTime?  @db.Date
  tier          SourceTier
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  evidence Evidence[]
  labs     Lab[]
}

/// One sourced claim about a taxonomy row, material or lab. `subjectCode` is the subject's code.
model Evidence {
  id          String          @id @default(cuid())
  code        String          @unique
  subjectType EvidenceSubject
  subjectCode String
  /// e.g. "typical_gsm", "softness_relative", "moisture_regain_pct"
  attribute   String
  claim       String
  valueText   String?
  valueMin    Float?
  valueMax    Float?
  unit        String?
  sourceId    String
  source      Source          @relation(fields: [sourceId], references: [id])
  /// Page, table or section
  locator     String?
  /// Short quote read from the source; null until checked (TODO(evidence))
  excerpt     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([subjectType, subjectCode])
}

/// A testing lab. A measurement is accredited only when its test is inside `scope`.
model Lab {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  city            String?
  accreditationNo String?
  scope           TestStandard[]
  scopeSourceId   String?
  scopeSource     Source?        @relation(fields: [scopeSourceId], references: [id])
  /// When GroupBasket last checked the scope document; null = not yet verified
  scopeVerifiedOn DateTime?      @db.Date
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  measurements Measurement[]
}

/// A lab-tested value. Belongs to exactly one of a product's material, a library material or
/// a calibration swatch.
model Measurement {
  id                  String             @id @default(cuid())
  productMaterialId   String?
  productMaterial     ProductMaterial?   @relation(fields: [productMaterialId], references: [id], onDelete: Cascade)
  materialId          String?
  material            Material?          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  calibrationSwatchId String?
  calibrationSwatch   CalibrationSwatch? @relation(fields: [calibrationSwatchId], references: [id], onDelete: Cascade)
  testStandard        TestStandard
  /// e.g. "bending_rigidity", "air_permeability", "mass_per_area", "stretch", "shrinkage"
  property            String
  value               Float
  unit                String
  direction           MeasureDirection   @default(AVG)
  labId               String?
  lab                 Lab?               @relation(fields: [labId], references: [id])
  labName             String
  labAccreditationNo  String?
  /// True only when the lab is known and the test is inside its accredited scope
  accredited          Boolean
  reportRef           String?
  /// Private PDF of the lab report
  reportKey           String?
  reportType          String?
  testedOn            DateTime           @db.Date
  enteredById         String
  createdAt           DateTime           @default(now())

  @@index([productMaterialId])
  @@index([materialId])
  @@index([calibrationSwatchId])
}

/// A versioned GroupBasket rule. Append-only: a change is a new version.
model MethodologyRule {
  id               String          @id @default(cuid())
  code             String
  version          Int
  attribute        String
  ruleDescription  String
  formula          String
  /// Rule tables (e.g. estimated bands per construction), each row citing evidence codes
  params           Json?
  calibrationSetId String?
  calibrationSet   CalibrationSet? @relation(fields: [calibrationSetId], references: [id])
  effectiveFrom    DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@unique([code, version])
}

/// The GroupBasket Reference Swatch Set: the fixed fabrics measured scales are ranked against
model CalibrationSet {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  version   Int       @default(1)
  /// The set measured scales use; null while it is still being measured
  activeAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  swatches CalibrationSwatch[]
  rules    MethodologyRule[]
}

model CalibrationSwatch {
  id         String         @id @default(cuid())
  setId      String
  set        CalibrationSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  materialId String
  material   Material       @relation(fields: [materialId], references: [id])
  label      String
  notes      String?
  createdAt  DateTime       @default(now())

  measurements Measurement[]

  @@unique([setId, label])
}

/// The fabric a product is made of, per role
model ProductMaterial {
  id                String            @id @default(cuid())
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId        String
  material          Material          @relation(fields: [materialId], references: [id])
  role              MaterialRole      @default(SHELL)
  /// Factory-declared, required
  actualGsm         Int
  /// Optional override of the library composition: [{ "fiber": "cotton_upland", "standard": null, "pct": 95 }]
  actualComposition Json?
  verificationLevel VerificationLevel @default(LIBRARY_ESTIMATE)
  /// Set when gsm or composition is far outside the library range and the factory confirmed it
  needsReviewAt     DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  /// Optional 12 s fabric motion video
  videoKey          String?
  videoType         String?
  setById           String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  measurements Measurement[]
  feel         FeelProfile?

  @@unique([productId, role])
  @@index([materialId])
  @@index([needsReviewAt])
}

/// Computed feel profile of one product material, rebuilt on every change
model FeelProfile {
  id                String          @id @default(cuid())
  productMaterialId String          @unique
  productMaterial   ProductMaterial @relation(fields: [productMaterialId], references: [id], onDelete: Cascade)
  computedAt        DateTime        @default(now())
  axes              FeelAxis[]
}

/// One slider: a point (`value`) when measured, a band when estimated, neither when not available
model FeelAxis {
  id             String      @id @default(cuid())
  profileId      String
  profile        FeelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  axis           FeelAxisKey
  basis          AxisBasis
  value          Float?
  bandMin        Float?
  bandMax        Float?
  ruleCode       String?
  ruleVersion    Int?
  evidenceCodes  String[]
  measurementIds String[]

  @@unique([profileId, axis])
}
