// GroupBasket data model. See CLAUDE.md "Business rules".
// Money is Decimal(14, 2), never Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

/// Every admin works in exactly one area (ADMIN-001/002); there is no unrestricted admin.
enum AdminArea {
  PREMIUM
  FACTORY
  /// Agents and orders (renamed from WAREHOUSE, area-agent model)
  AGENTS
  /// Settings and admin accounts only (product owner, 2026-11-03)
  CORE
}

/// A factory staff member's fixed job (product owner, 2026-11-04). Only owners see money.
enum FactoryRole {
  OWNER
  PACKING
  SALES
}

enum Role {
  /// A buyer: joins and fills carts
  CUSTOMER
  ADMIN
  /// A factory that supplies stock: lists products for an admin to review and publish
  SELLER
  /// An area agent who receives baskets from factories and hands parcels to buyers
  AGENT
}

model User {
  holdMessages   FaultHoldMessage[]
  factoryFaults  FactoryFault[]
  faultHolds     FaultHold[]
  returnMessages ReturnMessage[]
  qualityNotices QualityNotice[]
  productRatings ProductRating[]
  id             String             @id @default(cuid())
  role           Role               @default(CUSTOMER)
  adminArea      AdminArea? // admins only
  name           String
  email          String             @unique
  phone          String?            @unique
  passwordHash   String
  /// Default drop-off for carts this user owns
  address        String?
  city           String?
  /// Exact map pin of the address (mandatory at sign-up)
  lat            Float?
  lng            Float?
  /// Sellers: the factory or company name
  company        String?
  /// Premium brand partner: offers gift products and fulfils paid basket gifts directly.
  /// `website` verifies retail references on the brand's own site.
  isBrand        Boolean            @default(false)
  website        String?
  locked         Boolean            @default(false)
  /// Factory staff: the factory account they work for, and their job. The factory account itself
  /// has neither and is always an owner.
  factoryId      String?
  factory        User?              @relation("FactoryStaff", fields: [factoryId], references: [id], onDelete: Cascade)
  factoryRole    FactoryRole?
  createdAt      DateTime           @default(now())

  staff                User[]                @relation("FactoryStaff")
  factoryProfile       FactoryProfile?
  factoryApplications  FactoryApplication[]  @relation("ApplicationFactory")
  reviewedApplications FactoryApplication[]  @relation("ApplicationReviewer")
  factoryActivations   FactoryActivation[]   @relation("ActivationOwner")
  createdActivations   FactoryActivation[]   @relation("ActivationCreator")
  factoryInvites       FactoryInvite[]
  publishedAgreements  AgreementVersion[]
  factoryAcceptances   AgreementAcceptance[] @relation("AcceptanceFactory")
  acceptedAgreements   AgreementAcceptance[] @relation("AcceptancePerson")

  tokenEntries       TokenEntry[]
  sessions           Session[]
  notifications      Notification[]
  products           Product[]               @relation("SellerProducts")
  stockOffers        StockOffer[]            @relation("OfferSeller")
  stockReceived      StockOffer[]            @relation("StockReceivedBy")
  giftOrders         GiftOrder[]             @relation("GiftRecipient")
  brandSettlements   GiftSettlement[]
  brandConversations BrandConversation[]     @relation("ConversationBrand")
  brandMessages      BrandMessage[]
  brandReads         BrandConversationRead[]

  agent                Agent?
  cartItems            CartItem[]
  buyerOrders          Order[]           @relation("OrderBuyer")
  factoryOrders        Order[]           @relation("OrderFactory")
  buyerPaymentAttempts PaymentAttempt[]  @relation("AttemptBuyer")
  pickupCodes          PickupCode[]
  factoryBaskets       Basket[]          @relation("BasketFactory")
  factoryPayouts       FactoryPayout[]   @relation("PayoutFactory")
  paidPayouts          FactoryPayout[]   @relation("PayoutPaidBy")
  payoutDeductions     PayoutDeduction[] @relation("DeductionFactory")
  bookedCouriers       CourierBooking[]  @relation("CourierBookedBy")
  agentLossDecisions   AgentLoss[]       @relation("AgentLossDecider")

  @@index([factoryId])
}

model Session {
  /// SHA-256 of the cookie token
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Catalogue ─────────────────────────────────────────────────────────────

enum Category {
  SHOES
  APPAREL
}

enum StockType {
  FACTORY_SURPLUS
  B_GRADE
}

enum Audience {
  MEN
  WOMEN
  GIRL
  BOY
  KID
}

enum ProductStatus {
  DRAFT
  /// A seller submitted it; an admin publishes it once the stock has arrived, or returns it
  IN_REVIEW
  LIVE
  ARCHIVED
}

model Product {
  productRatings ProductRating[]
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   String?
  hiddenByHoldId String?
  hiddenByHold   FaultHold?      @relation(fields: [hiddenByHoldId], references: [id], onDelete: Restrict)
  id             String          @id @default(cuid())
  title          String
  brand          String
  description    String          @default("")
  category       Category
  /// Who it is for and the finer category (ids in src/lib/taxonomy.ts); null on older products
  audience       Audience?
  kind           String?
  stockType      StockType
  /// No longer used (defects removed by the product owner, 2026-10-17); kept so old notes aren't lost
  defectNotes    String?
  retailPrice    Decimal?        @db.Decimal(14, 2)
  price          Decimal         @db.Decimal(14, 2)
  factoryPrice   Decimal?        @db.Decimal(14, 2)
  commission     Decimal?        @db.Decimal(14, 2)
  status         ProductStatus   @default(DRAFT)
  photoKey       String?
  photoType      String?
  /// The factory that listed it; null for our own listings
  sellerId       String?
  seller         User?           @relation("SellerProducts", fields: [sellerId], references: [id])
  /// Why an admin returned it to the seller (shown to the seller)
  reviewNote     String?
  /// A luxury brand's product: the page on the brand's own website showing its actual price
  /// (`retailPrice`), linked from our product page (2026-10-24)
  brandUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  variants Variant[]
  /// Stock offers whose pieces went onto this product: a design test, then its bulk (2026-10-24)
  offers   StockOffer[]

  @@index([status, category])
  @@index([sellerId])
  @@index([status, audience, kind])
}

/// One size/colour of a product. available + reserved + sold is everything ever stocked.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  colour    String  @default("")
  /// Free to add to a cart
  available Int     @default(0)
  /// Locked in carts that are not yet confirmed
  reserved  Int     @default(0)
  /// Turned into sales when a cart is confirmed
  sold      Int     @default(0)

  orderLines OrderLine[]
  cartItems  CartItem[]

  @@unique([productId, size, colour])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  dedupeKey String?   @unique

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Stock offers ──────────────────────────────────────────────────────────

/// A few pieces to test a design before the factory makes the bulk, or the bulk itself (2026-10-24)
enum OfferKind {
  TEST
  BULK
}

enum OfferStatus {
  IN_REVIEW
  ACCEPTED
  DECLINED
  CHANGES_REQUESTED
}

/// A factory seller's stock offer (product owner, 2026-10-19): a name, details about the stock and
/// the total price they want for all of it. An admin accepts or declines it (with an optional
/// note). It is not a shop product: if we take the stock, the admin lists it as a product.
model StockOffer {
  id               String               @id @default(cuid())
  sellerId         String
  seller           User                 @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  name             String
  description      String
  /// Factory lot total, or legacy brand capacity value (partner price × pieces); not a gift bill.
  amount           Decimal              @db.Decimal(14, 2)
  kind             OfferKind            @default(BULK)
  /// Brand retail reference, private charge per authorized gift, campaign capacity and source URL.
  actualPrice      Decimal?             @db.Decimal(14, 2)
  offerPrice       Decimal?             @db.Decimal(14, 2)
  pieces           Int?
  productUrl       String?
  photoKey         String?
  photoType        String?
  packDetails      String?
  packSize         String?
  dispatchDays     Int?
  hasExpiry        Boolean              @default(false)
  expiryDate       DateTime?            @db.Date
  minShelfLifeDays Int?
  paused           Boolean              @default(false)
  revision         Int                  @default(1)
  approvedRevision Int?
  revisions        BrandOfferRevision[]
  gifts            GiftOrder[]
  /// The shop product its pieces went onto; a tested design's bulk goes onto the same one
  productId        String?
  product          Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  status           OfferStatus          @default(IN_REVIEW)
  note             String?
  decidedAt        DateTime?
  /// Packing staff confirm an accepted offer's stock has reached our store (2026-10-20)
  receivedById     String?
  receivedBy       User?                @relation("StockReceivedBy", fields: [receivedById], references: [id])
  receivedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

enum GiftOrderStatus {
  RESERVED
  READY
  DISPATCHED
  DELIVERED
  ISSUE
  CANCELLED
}

model GiftOrder {
  id               String          @id @default(cuid())
  offerId          String
  offer            StockOffer      @relation(fields: [offerId], references: [id])
  recipientId      String
  recipient        User            @relation("GiftRecipient", fields: [recipientId], references: [id])
  status           GiftOrderStatus @default(RESERVED)
  retailValue      Decimal         @db.Decimal(14, 2)
  partnerPrice     Decimal         @db.Decimal(14, 2)
  recipientName    String
  phone            String
  address          String
  city             String
  authorizedById   String
  courier          String?
  tracking         String?
  issue            String?
  paidAt           DateTime?
  acknowledgedAt   DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  billApprovedAt   DateTime?
  billApprovedById String?
  settlementId     String?
  settlement       GiftSettlement? @relation(fields: [settlementId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([offerId, status])
  @@index([recipientId])
  @@index([settlementId])
}

model GiftSettlement {
  id          String      @id @default(cuid())
  brandId     String
  brand       User        @relation(fields: [brandId], references: [id])
  amount      Decimal     @db.Decimal(14, 2)
  reference   String
  settledById String
  paidAt      DateTime
  createdAt   DateTime    @default(now())
  receivedAt  DateTime?
  queryOpen   Boolean     @default(false)
  gifts       GiftOrder[]

  @@index([brandId, paidAt])
}

model BrandConversation {
  id            String                  @id @default(cuid())
  brandId       String
  brand         User                    @relation("ConversationBrand", fields: [brandId], references: [id])
  kind          String
  subjectId     String
  contextKey    String                  @unique
  title         String
  resolved      Boolean                 @default(false)
  lastHumanSide String?
  updatedAt     DateTime                @default(now())
  createdAt     DateTime                @default(now())
  messages      BrandMessage[]
  reads         BrandConversationRead[]

  @@index([brandId, updatedAt])
}

model BrandMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   BrandConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation(fields: [authorId], references: [id])
  body           String
  internal       Boolean           @default(false)
  system         Boolean           @default(false)
  requestKey     String?           @unique
  notifiedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([notifiedAt])
}

model BrandConversationRead {
  conversationId String
  conversation   BrandConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime

  @@id([conversationId, userId])
}

model BrandOfferRevision {
  id            String      @id @default(cuid())
  offerId       String
  offer         StockOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  status        OfferStatus @default(IN_REVIEW)
  submittedById String
  reviewedById  String?
  reviewedAt    DateTime?
  supersededAt  DateTime?
  createdAt     DateTime    @default(now())

  @@unique([offerId, version])
}

// ─── Settings ──────────────────────────────────────────────────────────────

/// One row (id = 1).
model Settings {
  commissionPerPiece Decimal @default(100) @db.Decimal(14, 2)
  id                 Int     @id @default(1)

  // Agent model
  courierPerItem      Decimal   @default(40) @db.Decimal(14, 2)
  agentFeePerItem     Decimal   @default(20) @db.Decimal(14, 2)
  gatewayFeeRate      Decimal   @default(0.033) @db.Decimal(6, 4)
  basketLockAmount    Decimal   @default(50000) @db.Decimal(14, 2)
  maxWaitDays         Int       @default(60)
  paymentHoldMinutes  Int       @default(15)
  collectHours        Int       @default(48)
  returnHandoverDays  Int       @default(7)
  agentRadiusM        Int       @default(1000)
  agentGapM           Int       @default(2000)
  agentDeposit        Decimal   @default(200000) @db.Decimal(14, 2)
  /// The last week end (Saturday 23:59:59.999 Asia/Colombo) whose payouts and agent fees were built
  payoutsBuiltThrough DateTime?
}

enum ApplicationStatus {
  WAITING
  APPROVED
  REJECTED
}

enum FactoryDocKind {
  BR_CERT
  NIC_PHOTO
  FACTORY_PHOTO
}

enum FactoryStatus {
  ACTIVE
  REMOVED
}

model FactoryApplication {
  id            String            @id @default(cuid())
  businessName  String
  brNumber      String
  ownerName     String
  ownerNic      String
  phone         String
  email         String
  address       String
  city          String
  bankName      String
  bankBranch    String
  accountName   String
  accountNumber String
  status        ApplicationStatus @default(WAITING)
  reviewerId    String?
  reviewer      User?             @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  visitDate     DateTime?
  visitNotes    String?
  inviteId      String?           @unique
  invite        FactoryInvite?    @relation(fields: [inviteId], references: [id])
  factoryUserId String?
  factory       User?             @relation("ApplicationFactory", fields: [factoryUserId], references: [id])
  createdAt     DateTime          @default(now())
  documents     FactoryDocument[]

  @@index([brNumber])
  @@index([ownerNic])
  @@index([status, createdAt])
  @@index([factoryUserId])
}

model FactoryDocument {
  id            String             @id @default(cuid())
  applicationId String
  application   FactoryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          FactoryDocKind
  storageKey    String
  contentType   String

  @@index([applicationId])
}

model FactoryInvite {
  id          String              @id @default(cuid())
  token       String              @unique
  phone       String?
  email       String?
  invitedBy   String
  inviter     User                @relation(fields: [invitedBy], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  application FactoryApplication?
}

model AgreementVersion {
  id          String                @id @default(cuid())
  version     Int                   @unique
  text        String
  publishedAt DateTime              @default(now())
  publishedBy String
  publisher   User                  @relation(fields: [publishedBy], references: [id])
  acceptances AgreementAcceptance[]
}

model AgreementAcceptance {
  id            String           @id @default(cuid())
  factoryUserId String
  factory       User             @relation("AcceptanceFactory", fields: [factoryUserId], references: [id], onDelete: Cascade)
  acceptedById  String
  acceptedBy    User             @relation("AcceptancePerson", fields: [acceptedById], references: [id])
  versionId     String
  version       AgreementVersion @relation(fields: [versionId], references: [id])
  acceptedAt    DateTime         @default(now())
  endsAt        DateTime
  remindedAt    DateTime?

  @@index([factoryUserId, acceptedAt])
  @@index([remindedAt, endsAt])
}

model FactoryProfile {
  factoryUserId    String        @id
  factory          User          @relation(fields: [factoryUserId], references: [id], onDelete: Cascade)
  status           FactoryStatus @default(ACTIVE)
  complianceDueAt  DateTime?
  removedAt        DateTime?
  removedById      String?
  removalReason    String?
  earningsHeld     Boolean       @default(false)
  earningsHeldNote String?
}

model LoginAttempt {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model FactoryActivation {
  /// SHA-256 of the raw activation token; never a session credential.
  id          String    @id
  userId      String
  user        User      @relation("ActivationOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ActivationCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

enum TokenKind {
  RETURN
  HOLD
  RELEASE
  SPEND
  LATE_PAYMENT
  ORDER_CANCEL
  AGENT_FEE
  COURIER_REPAY
  MISSING_ITEM
  DEPOSIT_RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

model TokenEntry {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount         Decimal   @db.Decimal(14, 2)
  kind           TokenKind
  /// Audit references without foreign keys
  returnId       String?
  orderId        String?
  orderLineId    String?
  counterpartyId String?
  eventKey       String    @unique
  note           String
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([orderLineId])
}

enum LineStatus {
  ACTIVE
  CANCELLED
  RETURNED
}

enum ReportReason {
  DAMAGED
  WRONG_ITEM
  STITCHING
  SIZE
  OTHER
}

model ProductRating {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  stars     Int
  createdAt DateTime       @default(now())
  report    QualityReport?

  @@unique([orderId, userId, productId])
  @@index([productId, createdAt])
}

model QualityReport {
  id        String        @id @default(cuid())
  ratingId  String        @unique
  rating    ProductRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  reason    ReportReason
  note      String
  createdAt DateTime      @default(now())
  photos    ReportPhoto[]

  @@index([createdAt])
}

model ReportPhoto {
  id          String        @id @default(cuid())
  reportId    String
  report      QualityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String

  @@index([reportId])
}

model QualityNotice {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  title       String
  body        String
  href        String
  deliveredAt DateTime?

  @@index([deliveredAt])
}

enum ReturnStatus {
  WAITING_FACTORY
  WITH_ADMIN
  ACCEPTED
  REJECTED
  PICKED_UP
  RECEIVED
  COMPLETED
  AWAITING_HANDOVER
  HANDED_OVER
  LAPSED
}

enum ReturnFault {
  FACTORY
  BUYER
}

model ReturnRequest {
  factoryFault       FactoryFault?
  factoryNote        String?
  messages           ReturnMessage[]
  id                 String          @id @default(cuid())
  orderLineId        String
  orderLine          OrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  handoverAgentId    String?
  handoverAgent      Agent?          @relation("ReturnHandoverAgent", fields: [handoverAgentId], references: [id], onDelete: Restrict)
  handoverDueAt      DateTime?
  handedOverAt       DateTime?
  sentBackBasketId   String?
  sentBackBasket     Basket?         @relation("ReturnSentBack", fields: [sentBackBasketId], references: [id], onDelete: Restrict)
  buyerId            String
  factoryId          String
  qty                Int
  reason             ReportReason
  fault              ReturnFault
  note               String
  status             ReturnStatus    @default(WAITING_FACTORY)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  factoryDueAt       DateTime
  factoryDecidedAt   DateTime?
  factoryDecidedById String?
  escalatedAt        DateTime?
  adminDecision      Boolean?
  adminId            String?
  adminNote          String?
  receivedAt         DateTime?
  receivedById       String?
  unusedWithTags     Boolean?
  receivedCondition  String?
  paidBy             ReturnFault?
  photos             ReturnPhoto[]
  notices            ReturnNotice[]

  @@index([factoryId, status])
  @@index([buyerId, createdAt])
  @@index([status, factoryDueAt])
  @@index([orderLineId])
  @@index([handoverAgentId, status])
}

model ReturnPhoto {
  id          String        @id @default(cuid())
  returnId    String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String

  @@index([returnId])
}

model ReturnNotice {
  id          String        @id
  returnId    String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  href        String
  deliveredAt DateTime?

  @@index([deliveredAt])
}

model ReturnMessage {
  id        String        @id @default(cuid())
  returnId  String
  request   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String        @db.VarChar(1000)
  createdAt DateTime      @default(now())

  @@index([returnId, createdAt])
  @@index([authorId, createdAt])
}

enum FaultConfirmedBy {
  FACTORY
  ADMIN
}

enum HoldDecision {
  CONTINUE
  REMOVE
}

model FactoryFault {
  id            String           @id @default(cuid())
  factoryId     String
  factory       User             @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  returnId      String           @unique
  request       ReturnRequest    @relation(fields: [returnId], references: [id], onDelete: Restrict)
  units         Int
  recordedAt    DateTime         @default(now())
  confirmedBy   FaultConfirmedBy
  confirmedById String
  cancelledAt   DateTime?
  cancelledById String?
  cancelNote    String?          @db.VarChar(2000)

  @@index([factoryId, recordedAt])
}

model FaultHold {
  id           String             @id @default(cuid())
  factoryId    String
  factory      User               @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  openedAt     DateTime           @default(now())
  cleanedAt    DateTime?
  decision     HoldDecision?
  decisionNote String?            @db.VarChar(2000)
  decidedAt    DateTime?
  decidedById  String?
  products     Product[]
  messages     FaultHoldMessage[]

  @@index([factoryId, openedAt])
}

model FaultHoldMessage {
  id        String    @id @default(cuid())
  holdId    String
  hold      FaultHold @relation(fields: [holdId], references: [id], onDelete: Restrict)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String    @db.VarChar(1000)
  createdAt DateTime  @default(now())

  @@index([holdId, createdAt])
  @@index([authorId, createdAt])
}

// ─── Area agent model ──────────────────────────────────────────────────────

enum AgentStatus {
  APPLIED
  APPROVED
  LIVE
  SUSPENDED
  LEAVING
  LEFT
  REJECTED
}

model Agent {
  id               String      @id @default(cuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           AgentStatus @default(APPLIED)
  lat              Float
  lng              Float
  address          String
  city             String?
  /// Private storage keys; never public.
  nicKey           String?
  photoKey         String?
  storagePhotoKeys String[]
  depositPaidAt    DateTime?
  depositAmount    Decimal     @default(0) @db.Decimal(14, 2)
  leftAt           DateTime?
  lossAmount       Decimal     @default(0) @db.Decimal(14, 2)
  lossNote         String?
  suspendedAt      DateTime?
  /// Admin's note on the latest decision: rejection or suspension reason
  statusNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  hours           AgentHours[]
  baskets         Basket[]
  orders          Order[]
  pickupCodes     PickupCode[]
  pickupAttempts  PickupAttempt[]
  losses          AgentLoss[]
  paymentAttempts PaymentAttempt[]
  handoverReturns ReturnRequest[]  @relation("ReturnHandoverAgent")

  @@index([status])
}

model AgentHours {
  id       String @id @default(cuid())
  agentId  String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// 0 = Sunday .. 6 = Saturday
  weekday  Int
  /// Minutes after midnight, Asia/Colombo
  opensAt  Int
  closesAt Int

  @@unique([agentId, weekday])
}

model AgentLoss {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(14, 2)
  reason      String
  photoKeys   String[]
  decidedById String
  decidedBy   User     @relation("AgentLossDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([agentId])
}

/// Code entries at an agent's box, so repeated wrong codes can block it.
model PickupAttempt {
  id      String   @id @default(cuid())
  agentId String
  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  at      DateTime @default(now())
  ok      Boolean

  @@index([agentId, at])
}

/// A buyer's saved wish. Holds no stock.
model CartItem {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  createdAt DateTime @default(now())

  @@unique([buyerId, variantId])
  @@index([variantId])
}

enum BasketStatus {
  OPEN
  LOCKED
  PACKED
  WITH_COURIER
  AT_AGENT
}

enum BasketLockReason {
  AMOUNT
  MAX_WAIT
  SUSPENDED
}

/// The partial unique index "Basket_one_open" (one OPEN per agent and factory) is added by hand
/// in the migration SQL; Prisma cannot express it.
model Basket {
  id           String            @id @default(cuid())
  agentId      String
  agent        Agent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  factoryId    String
  factory      User              @relation("BasketFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  status       BasketStatus      @default(OPEN)
  /// Goods value only (items total)
  total        Decimal           @default(0) @db.Decimal(14, 2)
  firstOrderAt DateTime?
  lockedAt     DateTime?
  lockReason   BasketLockReason?
  createdAt    DateTime          @default(now())

  orders          Order[]
  courier         CourierBooking?
  sentBackReturns ReturnRequest[] @relation("ReturnSentBack")

  @@index([status])
  @@index([agentId, status])
  @@index([factoryId, status])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  RECEIVED
}

model Order {
  id               String          @id @default(cuid())
  buyerId          String
  buyer            User            @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  agentId          String
  agent            Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  factoryId        String
  factory          User            @relation("OrderFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  /// Set when paid
  basketId         String?
  basket           Basket?         @relation(fields: [basketId], references: [id], onDelete: Restrict)
  paymentAttemptId String?
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  status           OrderStatus     @default(PENDING)
  itemsTotal       Decimal         @db.Decimal(14, 2)
  courierTotal     Decimal         @db.Decimal(14, 2)
  agentFeeTotal    Decimal         @db.Decimal(14, 2)
  tokensApplied    Decimal         @default(0) @db.Decimal(14, 2)
  gatewayFee       Decimal         @default(0) @db.Decimal(14, 2)
  amountDue        Decimal         @db.Decimal(14, 2)
  holdUntil        DateTime
  paidAt           DateTime?
  receivedAt       DateTime?
  /// The buyer's checkout request key; repeats return the first result
  checkoutKey      String?
  createdAt        DateTime        @default(now())

  lines          OrderLine[]
  productRatings ProductRating[]

  @@index([buyerId, createdAt])
  @@index([buyerId, checkoutKey])
  @@index([basketId])
  @@index([paymentAttemptId])
  @@index([agentId, status])
  @@index([factoryId, status])
  @@index([status, holdUntil])
}

model OrderLine {
  id                  String     @id @default(cuid())
  orderId             String
  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String
  variant             Variant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty                 Int
  /// Snapshot: factory price + commission
  unitPrice           Decimal    @db.Decimal(14, 2)
  /// Snapshot
  factoryPrice        Decimal    @db.Decimal(14, 2)
  /// Snapshot of the courier charge per piece
  courierEach         Decimal    @db.Decimal(14, 2)
  /// Snapshot of the agent fee per piece
  agentFeeEach        Decimal    @db.Decimal(14, 2)
  status              LineStatus @default(ACTIVE)
  returnedQty         Int        @default(0)
  missingQty          Int        @default(0)
  /// Pending factory report of units it cannot supply; an admin removes them
  missingReportedQty  Int        @default(0)
  missingNote         String?
  missingReportedAt   DateTime?
  missingReportedById String?
  collectedAt         DateTime?

  returns     ReturnRequest[]
  payoutItems PayoutItem[]

  @@index([orderId])
  @@index([variantId])
}

enum PaymentPurpose {
  ORDERS
  DEPOSIT
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  LATE_PAID
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  purpose          PaymentPurpose
  buyerId          String?
  buyer            User?                @relation("AttemptBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// Deposits only
  agentId          String?
  agent            Agent?               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  amount           Decimal              @db.Decimal(14, 2)
  /// Deposits only: the deposit charged, without the gateway fee; returned on leaving
  depositPrincipal Decimal?             @db.Decimal(14, 2)
  currency         String               @default("LKR")
  status           PaymentAttemptStatus @default(PENDING)
  gatewayRef       String               @unique
  createdAt        DateTime             @default(now())
  expiresAt        DateTime

  orders Order[]
  events PaymentEvent[]

  @@index([buyerId, createdAt])
  @@index([agentId])
  @@index([status, expiresAt])
}

/// Append-only record of verified gateway notices.
model PaymentEvent {
  id         String          @id @default(cuid())
  gateway    String
  eventId    String
  attemptId  String?
  attempt    PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  outcome    Json
  verifiedAt DateTime        @default(now())

  @@unique([gateway, eventId])
  @@index([attemptId])
}

model PickupCode {
  id      String @id @default(cuid())
  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Six digits, unique among the agent's codes
  code    String

  @@unique([buyerId, agentId])
  @@unique([agentId, code])
}

model CourierBooking {
  id              String    @id @default(cuid())
  basketId        String    @unique
  basket          Basket    @relation(fields: [basketId], references: [id], onDelete: Restrict)
  fee             Decimal   @db.Decimal(14, 2)
  driverName      String
  driverPhone     String
  vehicleNo       String
  bookedById      String
  bookedBy        User      @relation("CourierBookedBy", fields: [bookedById], references: [id], onDelete: Restrict)
  givenToDriverAt DateTime?
  receivedAt      DateTime?
  failedAt        DateTime?
  createdAt       DateTime  @default(now())
}

model FactoryPayout {
  id         String    @id @default(cuid())
  factoryId  String
  factory    User      @relation("PayoutFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  /// Saturday 23:59:59 Asia/Colombo
  weekEnding DateTime
  gross      Decimal   @db.Decimal(14, 2)
  deductions Decimal   @default(0) @db.Decimal(14, 2)
  net        Decimal   @db.Decimal(14, 2)
  bankRef    String?
  paidAt     DateTime?
  paidById   String?
  paidBy     User?     @relation("PayoutPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())

  items         PayoutItem[]
  deductionRows PayoutDeduction[]

  @@unique([factoryId, weekEnding])
  @@index([paidAt])
}

model PayoutItem {
  id          String        @id @default(cuid())
  payoutId    String
  payout      FactoryPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(14, 2)

  @@unique([orderLineId])
  @@index([payoutId])
}

enum DeductionKind {
  RETURN_COURIER
  MISSING_ITEM
}

model PayoutDeduction {
  id        String         @id @default(cuid())
  factoryId String
  factory   User           @relation("DeductionFactory", fields: [factoryId], references: [id], onDelete: Restrict)
  /// Null while the deduction waits for the next payout
  payoutId  String?
  payout    FactoryPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  kind      DeductionKind
  amount    Decimal        @db.Decimal(14, 2)
  ref       String
  createdAt DateTime       @default(now())

  @@unique([kind, ref])
  @@index([factoryId, payoutId])
}
