// GroupBasket data model. See CLAUDE.md "Business rules".
// Money is Decimal(14, 2), never Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

/// Every admin works in exactly one area (ADMIN-001/002); there is no unrestricted admin.
enum AdminArea {
  PREMIUM
  FACTORY
  WAREHOUSE
  /// Settings and admin accounts only (product owner, 2026-11-03)
  CORE
}

/// A factory staff member's fixed job (product owner, 2026-11-04). Only owners see money.
enum FactoryRole {
  OWNER
  PACKING
  PLANNER
  SALES
}

enum Role {
  /// A buyer: joins and fills carts
  CUSTOMER
  ADMIN
  /// A factory that supplies stock: lists products for an admin to review and publish
  SELLER
  /// Our packing staff: one checks and gathers a paid order, another rechecks and packs it
  PACKER
}

model User {
  holdMessages   FaultHoldMessage[]
  factoryFaults  FactoryFault[]
  faultHolds     FaultHold[]
  returnMessages ReturnMessage[]
  qualityNotices QualityNotice[]
  productRatings ProductRating[]
  id             String             @id @default(cuid())
  role           Role               @default(CUSTOMER)
  adminArea      AdminArea? // admins only
  name           String
  email          String             @unique
  phone          String?            @unique
  passwordHash   String
  /// Default drop-off for carts this user owns
  address        String?
  city           String?
  /// Exact map pin of the address (mandatory at sign-up)
  lat            Float?
  lng            Float?
  /// Sellers: the factory or company name
  company        String?
  /// Premium brand partner: offers gift products and fulfils paid basket gifts directly.
  /// `website` verifies retail references on the brand's own site.
  isBrand        Boolean            @default(false)
  website        String?
  locked         Boolean            @default(false)
  /// Factory staff: the factory account they work for, and their job. The factory account itself
  /// has neither and is always an owner.
  factoryId      String?
  factory        User?              @relation("FactoryStaff", fields: [factoryId], references: [id], onDelete: Cascade)
  factoryRole    FactoryRole?
  createdAt      DateTime           @default(now())

  staff                User[]                @relation("FactoryStaff")
  factoryProfile       FactoryProfile?
  factoryApplications  FactoryApplication[]  @relation("ApplicationFactory")
  reviewedApplications FactoryApplication[]  @relation("ApplicationReviewer")
  factoryActivations   FactoryActivation[]   @relation("ActivationOwner")
  createdActivations   FactoryActivation[]   @relation("ActivationCreator")
  factoryInvites       FactoryInvite[]
  publishedAgreements  AgreementVersion[]
  factoryAcceptances   AgreementAcceptance[] @relation("AcceptanceFactory")
  acceptedAgreements   AgreementAcceptance[] @relation("AcceptancePerson")

  sampleRequests     SampleRequest[]
  tokenEntries       TokenEntry[]
  sessions           Session[]
  ownedCarts         GroupCart[]             @relation("CartOwner")
  factoryPackedCarts GroupCart[]             @relation("FactoryPacked")
  ratingsGiven       FactoryRating[]         @relation("RatingsGiven")
  ratingsReceived    FactoryRating[]         @relation("RatingsReceived")
  memberships        CartMember[]
  lines              CartLine[]
  slips              PaymentSlip[]           @relation("SlipUploader")
  reviewedSlips      PaymentSlip[]           @relation("SlipReviewer")
  messages           CartMessage[]           @relation("MessageParticipant")
  messagesSent       CartMessage[]           @relation("MessageAuthor")
  invitesSent        CartInvite[]            @relation("InviteFrom")
  invites            CartInvite[]            @relation("InviteTo")
  mergeRequests      CartMergeRequest[]
  notifications      Notification[]
  products           Product[]               @relation("SellerProducts")
  stockOffers        StockOffer[]            @relation("OfferSeller")
  stockReceived      StockOffer[]            @relation("StockReceivedBy")
  gathered           Packing[]               @relation("GatheredBy")
  packed             Packing[]               @relation("PackedBy")
  handedOver         Packing[]               @relation("HandedOverBy")
  giftOrders         GiftOrder[]             @relation("GiftRecipient")
  brandSettlements   GiftSettlement[]
  brandConversations BrandConversation[]     @relation("ConversationBrand")
  brandMessages      BrandMessage[]
  brandReads         BrandConversationRead[]

  @@index([factoryId])
}

model Session {
  /// SHA-256 of the cookie token
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Catalogue ─────────────────────────────────────────────────────────────

enum Category {
  SHOES
  APPAREL
}

enum StockType {
  FACTORY_SURPLUS
  B_GRADE
}

enum Audience {
  MEN
  WOMEN
  GIRL
  BOY
  KID
}

enum ProductStatus {
  DRAFT
  /// A seller submitted it; an admin publishes it once the stock has arrived, or returns it
  IN_REVIEW
  LIVE
  ARCHIVED
}

model Product {
  productRatings ProductRating[]
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   String?
  hiddenByHoldId String?
  hiddenByHold   FaultHold?      @relation(fields: [hiddenByHoldId], references: [id], onDelete: Restrict)
  id             String          @id @default(cuid())
  title          String
  brand          String
  description    String          @default("")
  category       Category
  /// Who it is for and the finer category (ids in src/lib/taxonomy.ts); null on older products
  audience       Audience?
  kind           String?
  stockType      StockType
  /// No longer used (defects removed by the product owner, 2026-10-17); kept so old notes aren't lost
  defectNotes    String?
  retailPrice    Decimal?        @db.Decimal(14, 2)
  price          Decimal         @db.Decimal(14, 2)
  factoryPrice   Decimal?        @db.Decimal(14, 2)
  commission     Decimal?        @db.Decimal(14, 2)
  status         ProductStatus   @default(DRAFT)
  photoKey       String?
  photoType      String?
  /// The factory that listed it; null for our own listings
  sellerId       String?
  seller         User?           @relation("SellerProducts", fields: [sellerId], references: [id])
  /// Why an admin returned it to the seller (shown to the seller)
  reviewNote     String?
  /// A luxury brand's product: the page on the brand's own website showing its actual price
  /// (`retailPrice`), linked from our product page (2026-10-24)
  brandUrl       String?
  /// The bulk lot it came from; its price then follows the lot's cost and margin
  lotId          String?
  lot            Lot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  samples  SampleRequest[]
  variants Variant[]
  /// Stock offers whose pieces went onto this product: a design test, then its bulk (2026-10-24)
  offers   StockOffer[]
  prices   PriceChange[]

  @@index([status, category])
  @@index([sellerId])
  @@index([status, audience, kind])
  @@index([lotId])
}

/// A bulk we bought (product owner, 2026-10-21). Bulk cost + transport + wages over its pieces is
/// the cost per piece. Its products sell at cost + fullMarginPct until reduceAt (7 days after it
/// reached our store), then at cost + reducedMarginPct. Margins and days are snapshotted from
/// Settings when the lot is created.
model Lot {
  id               String    @id @default(cuid())
  name             String
  pieces           Int
  bulkCost         Decimal   @db.Decimal(14, 2)
  transportCost    Decimal   @default(0) @db.Decimal(14, 2)
  wages            Decimal   @default(0) @db.Decimal(14, 2)
  /// Midnight (Colombo) of the day the bulk reached our store
  receivedAt       DateTime
  fullMarginPct    Int
  reducedMarginPct Int
  /// When its products drop to the reduced margin
  reduceAt         DateTime
  /// Set once the sweep has moved its products to the reduced price
  reducedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  products Product[]

  @@index([reducedAt, reduceAt])
  @@index([receivedAt])
}

/// The shop price of a product from `at` until the next row (product owner, 2026-10-24): the
/// seller dashboard charts price against pieces sold. Written whenever a product's price changes
/// (`logPrices` in src/server/designs.ts).
model PriceChange {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(14, 2)
  at        DateTime @default(now())

  @@index([productId, at])
}

/// One size/colour of a product. available + reserved + sold is everything ever stocked.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  colour    String  @default("")
  /// Free to add to a cart
  available Int     @default(0)
  /// Locked in carts that are not yet confirmed
  reserved  Int     @default(0)
  /// Turned into sales when a cart is confirmed
  sold      Int     @default(0)

  lines CartLine[]

  @@unique([productId, size, colour])
}

// ─── Group carts ───────────────────────────────────────────────────────────

enum Visibility {
  PUBLIC
  PRIVATE
}

enum CartStatus {
  /// Below the minimum: join, add, change, leave
  OPEN
  /// At or above the minimum, members notified; the owner can accept
  READY
  /// Owner accepted: frozen, owner has slipDueAt to upload one bank slip
  AWAITING_SLIP
  /// Slip uploaded, waiting for an admin
  SLIP_REVIEW
  CONFIRMED
  DISPATCHED
  DELIVERED
  EXPIRED
  CANCELLED
}

model GroupCart {
  productRatings     ProductRating[]
  cancelPickupReview Boolean         @default(false)
  id                 String          @id @default(cuid())
  /// Share code in /c/<code>
  code               String          @unique
  name               String          @default("")
  ownerId            String
  owner              User            @relation("CartOwner", fields: [ownerId], references: [id])
  visibility         Visibility      @default(PUBLIC)
  status             CartStatus      @default(OPEN)
  /// Snapshot of Settings.minOrderValue when the cart started
  minOrderValue      Decimal         @db.Decimal(14, 2)
  /// Sum of qty × unitPrice over all lines, kept in step in the same transaction
  total              Decimal         @default(0) @db.Decimal(14, 2)
  expiresAt          DateTime
  readyAt            DateTime?
  acceptedAt         DateTime?
  slipDueAt          DateTime?
  confirmedAt        DateTime?
  /// Factory-direct fulfilment (2026-11-03): when and by whom the factory packed this order
  factoryPackedAt    DateTime?
  factoryPackedById  String?
  factoryPackedBy    User?           @relation("FactoryPacked", fields: [factoryPackedById], references: [id])
  factoryRatings     FactoryRating[]
  deliveryAddress    String?
  deliveryCity       String?
  deliveryPhone      String?
  deliveryLat        Float?
  deliveryLng        Float?
  closedReason       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  members  CartMember[]
  lines    CartLine[]
  slips    PaymentSlip[]
  invites  CartInvite[]
  delivery Delivery?
  packing  Packing?
  gifts    GiftOrder[]
  samples  SampleRequest[]

  messages  CartMessage[]
  mergeFrom CartMergeRequest[] @relation("MergeFrom")
  mergeTo   CartMergeRequest[] @relation("MergeTo")

  @@index([status, visibility, createdAt])
  @@index([status, expiresAt])
  @@index([status, slipDueAt])
}

model CartMember {
  id       String    @id @default(cuid())
  cartId   String
  cart     GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  doneAt   DateTime?
  joinedAt DateTime  @default(now())
  /// Where this member is, pinned on the map when they joined
  address  String?
  city     String?
  lat      Float?
  lng      Float?

  @@unique([cartId, userId])
  @@index([userId])
}

/// One member's quantity of one variant. Its stock is locked while the cart is OPEN, READY,
/// AWAITING_SLIP or SLIP_REVIEW; closed carts keep their lines as history.
model CartLine {
  returnedQty      Int             @default(0)
  returns          ReturnRequest[]
  status           LineStatus      @default(ACTIVE)
  cancelledAt      DateTime?
  cancelReason     String?
  notEarned        Boolean         @default(false)
  cancelNotifiedAt DateTime?
  id               String          @id @default(cuid())
  cartId           String
  cart             GroupCart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  variantId        String
  variant          Variant         @relation(fields: [variantId], references: [id])
  tokensApplied    Decimal         @default(0) @db.Decimal(14, 2)
  tokenVersion     Int             @default(0)
  qty              Int
  /// Product price when first added
  unitPrice        Decimal         @db.Decimal(14, 2)
  createdAt        DateTime        @default(now())

  @@unique([cartId, userId, variantId])
  @@index([variantId])
  @@index([userId])
}

enum SlipStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The owner's one bank slip for the whole cart. A rejected slip can be replaced.
model PaymentSlip {
  id          String     @id @default(cuid())
  cartId      String
  cart        GroupCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User       @relation("SlipUploader", fields: [uploaderId], references: [id])
  amount      Decimal    @db.Decimal(14, 2)
  storageKey  String
  contentType String
  status      SlipStatus @default(PENDING)
  reviewNote  String?
  reviewerId  String?
  reviewer    User?      @relation("SlipReviewer", fields: [reviewerId], references: [id])
  reviewedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([status, createdAt])
  @@index([cartId])
}

enum MergeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// A buyer in one cart asks to join another: on accept by that cart's owner, their items move
/// over and their old cart goes (CLAUDE.md rule 13). One pending request per user.
model CartMergeRequest {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  /// The cart they are leaving; null once it has been deleted
  fromCartId String?
  fromCart   GroupCart?  @relation("MergeFrom", fields: [fromCartId], references: [id], onDelete: SetNull)
  toCartId   String
  toCart     GroupCart   @relation("MergeTo", fields: [toCartId], references: [id], onDelete: Cascade)
  status     MergeStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  decidedAt  DateTime?

  @@index([toCartId, status])
  @@index([userId, status])
}

model CartInvite {
  id            String    @id @default(cuid())
  cartId        String
  cart          GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User      @relation("InviteFrom", fields: [invitedById], references: [id])
  invitedUserId String
  invitedUser   User      @relation("InviteTo", fields: [invitedUserId], references: [id])
  createdAt     DateTime  @default(now())

  @@unique([cartId, invitedUserId])
  @@index([invitedUserId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  dedupeKey String?   @unique

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Delivery ──────────────────────────────────────────────────────────────

enum DeliveryStatus {
  BOOKED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

/// One PickMe drop per confirmed cart, to the owner. The owner pays the driver directly:
/// the platform never charges, collects or refunds the fee (quotedFee is shown only).
model Delivery {
  deliveredAt DateTime?
  id          String         @id @default(cuid())
  cartId      String         @unique
  cart        GroupCart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  provider    String
  externalRef String?
  status      DeliveryStatus @default(BOOKED)
  quotedFee   Decimal?       @db.Decimal(14, 2)
  /// Always the cart owner (the receiver)
  paidBy      String         @default("OWNER")
  driverName  String?
  driverPhone String?
  trackingUrl String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Packing a confirmed cart in our store (product owner, 2026-10-19): one of the packing staff
/// checks every item and gathers it all together, then a different person rechecks it and packs
/// it; only then is it handed to the PickMe driver. Deleted if it is sent back to be gathered again.
model Packing {
  id             String    @id @default(cuid())
  cartId         String    @unique
  cart           GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  /// First check: who checked the items and gathered them
  gatheredById   String
  gatheredBy     User      @relation("GatheredBy", fields: [gatheredById], references: [id])
  gatheredAt     DateTime  @default(now())
  /// Second check, by someone else: who rechecked and packed it
  packedById     String?
  packedBy       User?     @relation("PackedBy", fields: [packedById], references: [id])
  packedAt       DateTime?
  handedOverById String?
  handedOverBy   User?     @relation("HandedOverBy", fields: [handedOverById], references: [id])
  handedOverAt   DateTime?
}

// ─── Stock offers ──────────────────────────────────────────────────────────

/// A few pieces to test a design before the factory makes the bulk, or the bulk itself (2026-10-24)
enum OfferKind {
  TEST
  BULK
}

enum OfferStatus {
  IN_REVIEW
  ACCEPTED
  DECLINED
  CHANGES_REQUESTED
}

/// A factory seller's stock offer (product owner, 2026-10-19): a name, details about the stock and
/// the total price they want for all of it. An admin accepts or declines it (with an optional
/// note). It is not a shop product: if we take the stock, the admin lists it as a product.
model StockOffer {
  id               String               @id @default(cuid())
  sellerId         String
  seller           User                 @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  name             String
  description      String
  /// Factory lot total, or legacy brand capacity value (partner price × pieces); not a gift bill.
  amount           Decimal              @db.Decimal(14, 2)
  kind             OfferKind            @default(BULK)
  /// Brand retail reference, private charge per authorized gift, campaign capacity and source URL.
  actualPrice      Decimal?             @db.Decimal(14, 2)
  offerPrice       Decimal?             @db.Decimal(14, 2)
  pieces           Int?
  productUrl       String?
  photoKey         String?
  photoType        String?
  packDetails      String?
  packSize         String?
  dispatchDays     Int?
  hasExpiry        Boolean              @default(false)
  expiryDate       DateTime?            @db.Date
  minShelfLifeDays Int?
  paused           Boolean              @default(false)
  revision         Int                  @default(1)
  approvedRevision Int?
  revisions        BrandOfferRevision[]
  gifts            GiftOrder[]
  /// The shop product its pieces went onto; a tested design's bulk goes onto the same one
  productId        String?
  product          Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  status           OfferStatus          @default(IN_REVIEW)
  note             String?
  decidedAt        DateTime?
  /// Packing staff confirm an accepted offer's stock has reached our store (2026-10-20)
  receivedById     String?
  receivedBy       User?                @relation("StockReceivedBy", fields: [receivedById], references: [id])
  receivedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

enum GiftOrderStatus {
  RESERVED
  READY
  DISPATCHED
  DELIVERED
  ISSUE
  CANCELLED
}

model GiftOrder {
  id               String          @id @default(cuid())
  offerId          String
  offer            StockOffer      @relation(fields: [offerId], references: [id])
  cartId           String
  cart             GroupCart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  recipientId      String
  recipient        User            @relation("GiftRecipient", fields: [recipientId], references: [id])
  status           GiftOrderStatus @default(RESERVED)
  retailValue      Decimal         @db.Decimal(14, 2)
  partnerPrice     Decimal         @db.Decimal(14, 2)
  recipientName    String
  phone            String
  address          String
  city             String
  authorizedById   String
  courier          String?
  tracking         String?
  issue            String?
  paidAt           DateTime?
  acknowledgedAt   DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  billApprovedAt   DateTime?
  billApprovedById String?
  settlementId     String?
  settlement       GiftSettlement? @relation(fields: [settlementId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([offerId, status])
  @@index([cartId, recipientId])
  @@index([settlementId])
}

model GiftSettlement {
  id          String      @id @default(cuid())
  brandId     String
  brand       User        @relation(fields: [brandId], references: [id])
  amount      Decimal     @db.Decimal(14, 2)
  reference   String
  settledById String
  paidAt      DateTime
  createdAt   DateTime    @default(now())
  receivedAt  DateTime?
  queryOpen   Boolean     @default(false)
  gifts       GiftOrder[]

  @@index([brandId, paidAt])
}

model BrandConversation {
  id            String                  @id @default(cuid())
  brandId       String
  brand         User                    @relation("ConversationBrand", fields: [brandId], references: [id])
  kind          String
  subjectId     String
  contextKey    String                  @unique
  title         String
  resolved      Boolean                 @default(false)
  lastHumanSide String?
  updatedAt     DateTime                @default(now())
  createdAt     DateTime                @default(now())
  messages      BrandMessage[]
  reads         BrandConversationRead[]

  @@index([brandId, updatedAt])
}

model BrandMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   BrandConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation(fields: [authorId], references: [id])
  body           String
  internal       Boolean           @default(false)
  system         Boolean           @default(false)
  requestKey     String?           @unique
  notifiedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([notifiedAt])
}

model BrandConversationRead {
  conversationId String
  conversation   BrandConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime

  @@id([conversationId, userId])
}

model BrandOfferRevision {
  id            String      @id @default(cuid())
  offerId       String
  offer         StockOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  status        OfferStatus @default(IN_REVIEW)
  submittedById String
  reviewedById  String?
  reviewedAt    DateTime?
  supersededAt  DateTime?
  createdAt     DateTime    @default(now())

  @@unique([offerId, version])
}

// ─── Settings ──────────────────────────────────────────────────────────────

/// One row (id = 1). Changes apply to carts started afterwards (minOrderValue is snapshotted).
model Settings {
  commissionPerPiece Decimal @default(100) @db.Decimal(14, 2)
  id                 Int     @id @default(1)
  minOrderValue      Decimal @default(50000) @db.Decimal(14, 2)
  cartLifetimeHours  Int     @default(24)
  slipWindowHours    Int     @default(2)
  bankName           String  @default("")
  bankBranch         String  @default("")
  accountName        String  @default("")
  accountNumber      String  @default("")
  /// Pieces our store holds (product owner, 2026-10-21: 6,000)
  storeCapacity      Int     @default(6000)
  /// New lots: margin on cost for the first days, then the reduced margin (20% for 7 days, then 10%)
  fullMarginPct      Int     @default(20)
  reducedMarginPct   Int     @default(10)
  fullMarginDays     Int     @default(7)
}

/// A private conversation between a cart's owner and one other user (a member or someone asking
/// about the cart). `participantId` is the non-owner side; `authorId` is who wrote the message.
model CartMessage {
  id            String    @id @default(cuid())
  cartId        String
  cart          GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  participantId String
  participant   User      @relation("MessageParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime  @default(now())
  /// When the other side (not the author) opened the conversation; null = unread
  readAt        DateTime?

  @@index([cartId, participantId, createdAt])
  @@index([participantId, readAt])
}

enum SampleStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  DISPATCHED
  DELIVERED
  DECLINED
  CANCELLED
}

/// Pre-purchase design sample: no sample sending fee; transport is paid by the group.
model SampleRequest {
  id            String       @id @default(cuid())
  cartId        String
  cart          GroupCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  requesterId   String
  requester     User         @relation(fields: [requesterId], references: [id])
  status        SampleStatus @default(REQUESTED)
  designNote    String       @default("")
  recipientName String
  address       String
  city          String
  phone         String
  lat           Float
  lng           Float
  transportFee  Decimal?     @db.Decimal(14, 2)
  courier       String?
  tracking      String?
  note          String?
  handledById   String?
  acceptedAt    DateTime?
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([cartId, createdAt])
  @@index([status, createdAt])
}

/// A member's 1–5 star rating of the factory that packed and shipped a delivered cart
/// (product owner, 2026-11-03). One per member per cart.
model FactoryRating {
  id        String    @id @default(cuid())
  cartId    String
  cart      GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("RatingsGiven", fields: [userId], references: [id], onDelete: Cascade)
  factoryId String
  factory   User      @relation("RatingsReceived", fields: [factoryId], references: [id], onDelete: Cascade)
  stars     Int
  createdAt DateTime  @default(now())

  @@unique([cartId, userId])
  @@index([factoryId, createdAt])
}

enum ApplicationStatus {
  WAITING
  APPROVED
  REJECTED
}

enum FactoryDocKind {
  BR_CERT
  NIC_PHOTO
  FACTORY_PHOTO
}

enum FactoryStatus {
  ACTIVE
  REMOVED
}

model FactoryApplication {
  id            String            @id @default(cuid())
  businessName  String
  brNumber      String
  ownerName     String
  ownerNic      String
  phone         String
  email         String
  address       String
  city          String
  bankName      String
  bankBranch    String
  accountName   String
  accountNumber String
  status        ApplicationStatus @default(WAITING)
  reviewerId    String?
  reviewer      User?             @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  visitDate     DateTime?
  visitNotes    String?
  inviteId      String?           @unique
  invite        FactoryInvite?    @relation(fields: [inviteId], references: [id])
  factoryUserId String?
  factory       User?             @relation("ApplicationFactory", fields: [factoryUserId], references: [id])
  createdAt     DateTime          @default(now())
  documents     FactoryDocument[]

  @@index([brNumber])
  @@index([ownerNic])
  @@index([status, createdAt])
  @@index([factoryUserId])
}

model FactoryDocument {
  id            String             @id @default(cuid())
  applicationId String
  application   FactoryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          FactoryDocKind
  storageKey    String
  contentType   String

  @@index([applicationId])
}

model FactoryInvite {
  id          String              @id @default(cuid())
  token       String              @unique
  phone       String?
  email       String?
  invitedBy   String
  inviter     User                @relation(fields: [invitedBy], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  application FactoryApplication?
}

model AgreementVersion {
  id          String                @id @default(cuid())
  version     Int                   @unique
  text        String
  publishedAt DateTime              @default(now())
  publishedBy String
  publisher   User                  @relation(fields: [publishedBy], references: [id])
  acceptances AgreementAcceptance[]
}

model AgreementAcceptance {
  id            String           @id @default(cuid())
  factoryUserId String
  factory       User             @relation("AcceptanceFactory", fields: [factoryUserId], references: [id], onDelete: Cascade)
  acceptedById  String
  acceptedBy    User             @relation("AcceptancePerson", fields: [acceptedById], references: [id])
  versionId     String
  version       AgreementVersion @relation(fields: [versionId], references: [id])
  acceptedAt    DateTime         @default(now())
  endsAt        DateTime
  remindedAt    DateTime?

  @@index([factoryUserId, acceptedAt])
  @@index([remindedAt, endsAt])
}

model FactoryProfile {
  factoryUserId    String        @id
  factory          User          @relation(fields: [factoryUserId], references: [id], onDelete: Cascade)
  status           FactoryStatus @default(ACTIVE)
  complianceDueAt  DateTime?
  removedAt        DateTime?
  removedById      String?
  removalReason    String?
  earningsHeld     Boolean       @default(false)
  earningsHeldNote String?
}

model LoginAttempt {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model FactoryActivation {
  /// SHA-256 of the raw activation token; never a session credential.
  id          String    @id
  userId      String
  user        User      @relation("ActivationOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ActivationCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

enum TokenKind {
  CANCELLATION
  RETURN
  HOLD
  RELEASE
  SPEND
}

model TokenEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount     Decimal   @db.Decimal(14, 2)
  kind       TokenKind
  /// Immutable audit references survive line deletion; deliberately not cascading foreign keys.
  cartLineId String?
  returnId   String?
  eventKey   String    @unique
  note       String
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([cartLineId])
}

enum LineStatus {
  ACTIVE
  CANCELLED
  RETURNED
}

enum ReportReason {
  DAMAGED
  WRONG_ITEM
  STITCHING
  SIZE
  OTHER
}

model ProductRating {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartId    String
  cart      GroupCart      @relation(fields: [cartId], references: [id], onDelete: Restrict)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  stars     Int
  createdAt DateTime       @default(now())
  report    QualityReport?

  @@unique([cartId, userId, productId])
  @@index([productId, createdAt])
}

model QualityReport {
  id        String        @id @default(cuid())
  ratingId  String        @unique
  rating    ProductRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  reason    ReportReason
  note      String
  createdAt DateTime      @default(now())
  photos    ReportPhoto[]

  @@index([createdAt])
}

model ReportPhoto {
  id          String        @id @default(cuid())
  reportId    String
  report      QualityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String

  @@index([reportId])
}

model QualityNotice {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  title       String
  body        String
  href        String
  deliveredAt DateTime?

  @@index([deliveredAt])
}

enum ReturnStatus {
  WAITING_FACTORY
  WITH_ADMIN
  ACCEPTED
  REJECTED
  PICKED_UP
  RECEIVED
  COMPLETED
}

enum ReturnFault {
  FACTORY
  BUYER
}

model ReturnRequest {
  factoryFault       FactoryFault?
  factoryNote        String?
  messages           ReturnMessage[]
  id                 String          @id @default(cuid())
  cartLineId         String
  cartLine           CartLine        @relation(fields: [cartLineId], references: [id], onDelete: Restrict)
  buyerId            String
  factoryId          String
  qty                Int
  reason             ReportReason
  fault              ReturnFault
  note               String
  status             ReturnStatus    @default(WAITING_FACTORY)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  factoryDueAt       DateTime
  factoryDecidedAt   DateTime?
  factoryDecidedById String?
  escalatedAt        DateTime?
  adminDecision      Boolean?
  adminId            String?
  adminNote          String?
  receivedAt         DateTime?
  receivedById       String?
  unusedWithTags     Boolean?
  receivedCondition  String?
  pickupRef          String?
  pickupDriver       String?
  pickupBookedAt     DateTime?
  pickupBookedById   String?
  paidBy             ReturnFault?
  photos             ReturnPhoto[]
  notices            ReturnNotice[]

  @@index([factoryId, status])
  @@index([buyerId, createdAt])
  @@index([status, factoryDueAt])
  @@index([cartLineId])
}

model ReturnPhoto {
  id          String        @id @default(cuid())
  returnId    String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String

  @@index([returnId])
}

model ReturnNotice {
  id          String        @id
  returnId    String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  href        String
  deliveredAt DateTime?

  @@index([deliveredAt])
}

model ReturnMessage {
  id        String        @id @default(cuid())
  returnId  String
  request   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String        @db.VarChar(1000)
  createdAt DateTime      @default(now())

  @@index([returnId, createdAt])
  @@index([authorId, createdAt])
}

enum FaultConfirmedBy {
  FACTORY
  ADMIN
}

enum HoldDecision {
  CONTINUE
  REMOVE
}

model FactoryFault {
  id            String           @id @default(cuid())
  factoryId     String
  factory       User             @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  returnId      String           @unique
  request       ReturnRequest    @relation(fields: [returnId], references: [id], onDelete: Restrict)
  units         Int
  recordedAt    DateTime         @default(now())
  confirmedBy   FaultConfirmedBy
  confirmedById String
  cancelledAt   DateTime?
  cancelledById String?
  cancelNote    String?          @db.VarChar(2000)

  @@index([factoryId, recordedAt])
}

model FaultHold {
  id           String             @id @default(cuid())
  factoryId    String
  factory      User               @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  openedAt     DateTime           @default(now())
  cleanedAt    DateTime?
  decision     HoldDecision?
  decisionNote String?            @db.VarChar(2000)
  decidedAt    DateTime?
  decidedById  String?
  products     Product[]
  messages     FaultHoldMessage[]

  @@index([factoryId, openedAt])
}

model FaultHoldMessage {
  id        String    @id @default(cuid())
  holdId    String
  hold      FaultHold @relation(fields: [holdId], references: [id], onDelete: Restrict)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String    @db.VarChar(1000)
  createdAt DateTime  @default(now())

  @@index([holdId, createdAt])
  @@index([authorId, createdAt])
}
