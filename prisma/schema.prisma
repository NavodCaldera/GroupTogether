// GroupBasket: family-pack group buying (DEC-030). Money is Decimal(14, 2), never Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  /// Delivery address and its map pin; baskets are found within 1 km of it
  address      String?
  city         String?
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now())

  sessions          Session[]
  tokenEntries      TokenEntry[]
  paymentAttempts   PaymentAttempt[]
  packMembers       PackMember[]
  startedPackGroups PackGroup[]      @relation("PackGroupStarter")
  contacts          UserContact[]
}

model Session {
  /// SHA-256 of the cookie token
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Settings {
  id                 Int @id @default(1)
  paymentHoldMinutes Int @default(15)
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  companies Company[]
}

model Company {
  id         String         @id @default(cuid())
  slug       String         @unique
  name       String
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Sample listing, not a real partnership
  demo       Boolean        @default(false)
  /// Logo image path, e.g. /logos/hemas.png
  logo       String?
  active     Boolean        @default(true)
  sortOrder  Int            @default(0)
  packs      StandardPack[]
  deliveries PackDelivery[]

  @@index([categoryId])
}

model StandardPack {
  id           String        @id @default(cuid())
  slug         String        @unique
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String
  durationDays Int
  active       Boolean       @default(true)
  versions     PackVersion[]
}

/// Fixed contents, price, size and commission; never edited once published.
model PackVersion {
  id             String       @id @default(cuid())
  packId         String
  pack           StandardPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  version        Int
  publishedAt    DateTime?
  pricePerFamily Decimal      @db.Decimal(14, 2)
  /// Families in one basket, 5 to 15
  groupSize      Int
  householdSize  Int?
  commissionPct  Decimal      @default(0) @db.Decimal(5, 2)
  items          PackItem[]
  groups         PackGroup[]

  @@unique([packId, version])
}

model PackItem {
  id        String      @id @default(cuid())
  versionId String
  version   PackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name      String
  size      String
  qty       Int
  sortOrder Int         @default(0)
}

enum PackGroupStatus {
  /// Started; waiting for the owner's payment
  PENDING
  OPEN
  FULL
  CLOSED
}

/// A basket: one pack version, delivered to its owner (the first payer).
model PackGroup {
  id          String          @id @default(cuid())
  versionId   String
  version     PackVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User            @relation("PackGroupStarter", fields: [createdById], references: [id], onDelete: Restrict)
  /// The owner's address when the basket started
  lat         Float
  lng         Float
  address     String
  city        String?
  status      PackGroupStatus @default(PENDING)
  /// Held and paid spots
  joined      Int             @default(0)
  extensions  Int             @default(0)
  closesAt    DateTime
  createdAt   DateTime        @default(now())
  members     PackMember[]
  delivery    PackDelivery?

  @@index([versionId, status])
  @@index([status, closesAt])
  @@index([lat, lng])
}

enum PackMemberStatus {
  HELD
  PAID
}

model PackMember {
  id        String           @id @default(cuid())
  groupId   String
  group     PackGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    PackMemberStatus @default(HELD)
  heldUntil DateTime?
  joinedAt  DateTime         @default(now())
  attempts  PaymentAttempt[]

  @@unique([groupId, userId])
  @@index([userId])
}

enum PackDeliveryStatus {
  ORDERED
  DISPATCHED
  RECEIVED
}

/// A full basket's one order to its company, delivered to the owner.
model PackDelivery {
  id         String             @id @default(cuid())
  groupId    String             @unique
  group      PackGroup          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  companyId  String
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  families   Int
  amountDue  Decimal            @db.Decimal(14, 2)
  status     PackDeliveryStatus @default(ORDERED)
  createdAt  DateTime           @default(now())
  receivedAt DateTime?
}

/// Phone numbers from a buyer's contacts (mobile app); their baskets are listed first.
model UserContact {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone  String

  @@id([userId, phone])
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  LATE_PAID
}

/// One payment for one basket spot.
model PaymentAttempt {
  id           String               @id @default(cuid())
  buyerId      String
  buyer        User                 @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  amount       Decimal              @db.Decimal(14, 2)
  currency     String               @default("LKR")
  status       PaymentAttemptStatus @default(PENDING)
  gatewayRef   String               @unique
  createdAt    DateTime             @default(now())
  expiresAt    DateTime
  packMemberId String?
  packMember   PackMember?          @relation(fields: [packMemberId], references: [id], onDelete: SetNull)
  events       PaymentEvent[]

  @@index([buyerId, createdAt])
  @@index([packMemberId])
  @@index([status, expiresAt])
}

/// Append-only record of verified gateway notices.
model PaymentEvent {
  id         String          @id @default(cuid())
  gateway    String
  eventId    String
  attemptId  String?
  attempt    PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  outcome    Json
  verifiedAt DateTime        @default(now())

  @@unique([gateway, eventId])
  @@index([attemptId])
}

enum TokenKind {
  /// A basket closed unfilled
  PACK_REFUND
  /// A payment that arrived after its spot was released, or for the wrong amount
  LATE_PAYMENT
}

/// Append-only (database trigger): entries are never updated or deleted.
model TokenEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount    Decimal   @db.Decimal(14, 2)
  kind      TokenKind
  eventKey  String    @unique
  note      String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
