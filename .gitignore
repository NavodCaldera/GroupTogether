# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# `npm run dev:phone` self-signed certificate
/certificates

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
!.env.example

# prisma generated client
/src/generated/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# local data
/.data/

# Local agent runtime output and browser sessions
/.playwright-cli/
/.playwright-mcp/

# editor settings
/.vscode/

# fit runtimes and models (scripts/copy-fit-assets.mjs, npm run fit:models)
/public/draco/
/public/fit-vision/

# Python bytecode (tools/fit-simulation)
__pycache__/

# Python virtual environments and test caches (tools/body-fitting)
.venv/
.pytest_cache/
