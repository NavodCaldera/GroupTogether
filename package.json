{
  "name": "groupbasket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --project mobile",
    "browser": "playwright-cli",
    "mcp:verify": "node scripts/verify-mcp.mjs",
    "mcp:setup-reader": "node scripts/setup-ai-reader.mjs",
    "check:money": "node scripts/check-money.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "check": "npm run check:money && npm run check:docs && npm run typecheck && npm run lint && npm run test:tooling && npm run test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:studio": "prisma studio",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "decimal.js": "^10.6.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@hovecapital/read-only-postgres-mcp-server": "0.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/cli": "0.1.22",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "embedded-postgres": "^18.3.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.10.2",
    "next-devtools-mcp": "0.4.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "next-devtools-mcp": {
      "zod": "4.6.7"
    },
    "fast-uri": "3.1.9",
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
  }
}
