# PostgreSQL. `npm run db:start` runs local dev (5546) and test (5547) servers with no password.
DATABASE_URL="postgres://postgres@localhost:5546/groupbasket"
DATABASE_POOL_MAX="10"

# Integration and e2e tests run against a separate database that gets wiped.
TEST_DATABASE_URL="postgres://postgres@localhost:5547/groupbasket_test"

# Public URL of the site, used in share links and emails.
APP_URL="http://localhost:3002"

# Product and private photos (local disk; swap for object storage when hosting is chosen)
STORAGE_DIR=".data/uploads"

# Bearer token for POST /api/cron/sweep (order expiry, basket locks, returns, payouts)
CRON_SECRET="CHANGE_ME"

# Show the demo accounts (admin, seller, buyer; password123) on the sign-in page. They always show
# in development; set "true" to show them on a hosted demo. Never on the real site.
SHOW_DEMO_LOGINS="false"

# Sentry error reporting (free tier). Empty DSN = Sentry off. Never commit real values.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Source map upload at build time, and the project the Claude Code Sentry MCP is scoped to.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Payment gateway. "demo" serves a fake hosted page at /demo-pay/[attemptId] that posts a signed
# notice like PayHere's. PayHere comes later behind the same adapter. Never "demo" on the real site.
PAYMENT_GATEWAY="demo"
DEMO_MERCHANT_ID="1200000"
DEMO_MERCHANT_SECRET="CHANGE_ME"
