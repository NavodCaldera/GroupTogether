# PostgreSQL. `npm run db:start` runs local dev (5546) and test (5547) servers with no password.
DATABASE_URL="postgres://postgres@localhost:5546/grouptogether"
DATABASE_POOL_MAX="10"

# Integration and e2e tests run against a separate database that gets wiped.
TEST_DATABASE_URL="postgres://postgres@localhost:5547/grouptogether_test"

# Public URL of the site, used in share links and emails.
APP_URL="http://localhost:3002"

# Bank slips and product photos (local disk; swap for object storage when hosting is chosen)
STORAGE_DIR=".data/uploads"

# Email: "mock" logs to the console; "gmail" sends through Gmail SMTP with an app password
# (Google account → Security → 2-Step Verification → App passwords). About 500 emails a day.
MAILER="mock"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Delivery: "manual" (admin enters the PickMe booking by hand) until PickMe business API keys arrive.
DELIVERY_PROVIDER="manual"
PICKME_API_URL=""
PICKME_API_KEY=""
PICKME_MERCHANT_ID=""
# Signs PickMe webhooks (HMAC-SHA256 of the body, hex, in x-signature)
PICKME_WEBHOOK_SECRET="CHANGE_ME"

# Bearer token for POST /api/cron/sweep (expires carts and missed 2h slip windows)
CRON_SECRET="CHANGE_ME"
