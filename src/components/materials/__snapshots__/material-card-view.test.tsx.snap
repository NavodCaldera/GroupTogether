exports[`MaterialCardView > renders a lab-measured card 1`] = `"<div class="flex flex-col gap-4" data-testid="material-card"><div class="flex flex-wrap items-start justify-between gap-2"><div class="min-w-0"><h3 class="font-semibold">Combed cotton jersey</h3><p class="text-sm text-subtle">Feels like an everyday T-shirt</p></div><span class="inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap bg-accent text-on-accent">Lab-measured</span></div><p class="text-sm capitalize">smooth · soft</p><div class="flex flex-col gap-3"><div class="flex flex-col gap-1"><p class="sr-only">Softness: measured 40 out of 100, where 0 is softest</p><div aria-hidden="true" class="flex items-center justify-between text-xs text-subtle"><span>Soft</span><span>Firm</span></div><div aria-hidden="true" class="relative h-2 rounded-full bg-muted"><span class="absolute top-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-paper bg-ink" style="left:40%"></span></div></div><div class="flex flex-col gap-1"><p class="sr-only">Weight: measured 28.8 out of 100, where 0 is lightest</p><div aria-hidden="true" class="flex items-center justify-between text-xs text-subtle"><span>Light</span><span>Substantial</span></div><div aria-hidden="true" class="relative h-2 rounded-full bg-muted"><span class="absolute top-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-paper bg-ink" style="left:28.8%"></span></div></div><div class="flex flex-col gap-1"><p class="sr-only">Surface: measured 12 out of 100, where 0 is smoothest</p><div aria-hidden="true" class="flex items-center justify-between text-xs text-subtle"><span>Smooth</span><span>Textured</span></div><div aria-hidden="true" class="relative h-2 rounded-full bg-muted"><span class="absolute top-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-paper bg-ink" style="left:12%"></span></div></div><div class="flex flex-col gap-1"><p class="sr-only">Breathability: measured 30 out of 100, where 0 is most breathable</p><div aria-hidden="true" class="flex items-center justify-between text-xs text-subtle"><span>Breathable</span><span>Insulating</span></div><div aria-hidden="true" class="relative h-2 rounded-full bg-muted"><span class="absolute top-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-paper bg-ink" style="left:30%"></span></div></div></div><dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm"><dt class="text-subtle">On skin</dt><dd>Absorbs sweat</dd></dl><dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm"><div class="contents"><dt class="text-subtle">Weight</dt><dd class="min-w-0 break-words">160 gsm · Light</dd></div><div class="contents"><dt class="text-subtle">Composition</dt><dd class="min-w-0 break-words">100% Upland cotton · Combed ring-spun</dd></div><div class="contents"><dt class="text-subtle">Air permeability</dt><dd class="min-w-0 break-words">120 mm/s · ISO 9237 · not accredited</dd></div></dl><p class="whitespace-pre-line text-sm text-subtle">Machine wash cold</p></div>"`;

